#!/bin/bash
# Reusable, receipt-backed VKMT prefix lifecycle.  It deliberately stages only
# components for which this tree has a supported prefix staging contract.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
BUILD="${WINEBUILDDIR:-$ROOT/wine/build-ec}"
WINE="$BUILD/wine"; SERVER="$BUILD/server/wineserver"
BOOT="$BUILD/programs/wineboot/aarch64-windows/wineboot.exe"
die() { echo "vkmt-prefix: $*" >&2; exit 1; }
sha() { shasum -a 256 "$1" | awk '{print $1}'; }
usage() { echo "usage: $0 {create --profile PROFILE|sync-providers|sync-wow64|sync-dxmt|sync-graphics32|refresh|verify|warm|reset|destroy} --prefix ABSOLUTE_PATH; $0 run --prefix ABSOLUTE_PATH [--allow-stale] -- PROGRAM [ARGS...]" >&2; exit 2; }
canon() { case "$1" in /*) ;; *) die "prefix must be absolute" ;; esac; if test -e "$1"; then (cd "$1" && pwd -P); else (cd "$(dirname "$1")" && printf '%s/%s\n' "$PWD" "$(basename "$1")"); fi; }
safe() {
  test "$1" != / && test "$1" != "$ROOT" && test "$1" != "$BUILD" || die "unsafe prefix path"
  case "$1" in "$ROOT"/build/*|"$ROOT"/prefixes/*) ;; *) die "prefix must be below $ROOT/build or $ROOT/prefixes" ;; esac
}
host() {
  local f t
  for f in "$WINE" "$SERVER" "$BUILD/dlls/ntdll/ntdll.so"; do
    test -f "$f" || die "missing host artifact: $f"
    test "$(/usr/bin/lipo -archs "$f")" = arm64 || die "not ARM64-only: $f"
  done
  if t=$(/usr/sbin/sysctl -in sysctl.proc_translated 2>/dev/null); then test "$t" = 0 || die "Rosetta is unsupported"; fi
  test "${FEX_TSOENABLED:-0}" = 0 && test "${FEX_VECTORTSOENABLED:-0}" = 0 && test "${FEX_MEMCPYSETTSOENABLED:-0}" = 0 || die "all FEX TSO modes must be zero"
}
profile() { case "$1" in core|graphics|browser|managed|full) ;; *) die "unknown profile: $1";; esac; }
graphics() { case "$1" in graphics|browser|full) return 0;; *) return 1;; esac; }
dxmt_enabled() { test "${VKMT_PREFIX_STAGE_DXMT:-1}" = 1; }
meta() { printf '%s/.vkmt\n' "$1"; }
stop() { WINEPREFIX="$1" "$SERVER" -k >/dev/null 2>&1 || true; WINEPREFIX="$1" "$SERVER" -w >/dev/null 2>&1 || true; }
owned() {
  local r="$(meta "$1")/receipt.json"
  test -f "$r" || die "prefix is not VKMT-owned"
  test "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["prefix"])' "$r")" = "$1" || die "receipt prefix mismatch"
}
atomic() { local d="$1" t="$1.tmp.$$"; cat >"$t"; mv -f "$t" "$d"; }
stage_closure() {
  local p="$1" s="$p/drive_c/windows/system32" w="$p/drive_c/windows/syswow64" f base known_names
  mkdir -p "$s" "$w"
  # Wineboot can repopulate syswow64 with a DLL that is not part of the
  # source-built i386 closure (for example an obsolete 16-bit compatibility
  # module).  Remove only those prefix-owned stale closure files before
  # rebuilding the manifest; never touch the source or unrelated prefix data.
  known_names="$(mktemp)"
  find "$BUILD/dlls" -type f -path '*/i386-windows/*.dll' -exec basename {} \; | LC_ALL=C sort -u >"$known_names"
  printf '%s\n' d3d11.dll dxgi.dll d3d12.dll d3d12core.dll >>"$known_names"
  while IFS= read -r f; do
    base="$(basename "$f")"
    grep -Fqx "$base" "$known_names" || rm -f "$f"
  done < <(find "$w" -type f -name '*.dll' -print)
  rm -f "$known_names"
  for f in "$BUILD/dlls/wow64/aarch64-windows/wow64.dll" "$BUILD/dlls/wow64win/aarch64-windows/wow64win.dll"; do test -f "$f" || die "missing $f"; install -m 0644 "$f" "$s/$(basename "$f")"; done
  while IFS= read -r f; do install -m 0644 "$f" "$w/$(basename "$f")"; done < <(find "$BUILD/dlls" -type f -path '*/i386-windows/*.dll' -print | LC_ALL=C sort)
}
manifest() {
  local p="$1" m="$(meta "$1")/staged-files.manifest" f rel src base candidate candidates
  local dxvk32="$ROOT/third_party/dxvk/runtime/dxvk-vkmt-1a5919b/x32"
  local vkd3d32="$ROOT/third_party/vkd3d-proton/install-win32/bin"
  { printf 'schema\t1\n'
    while IFS= read -r f; do
      rel="${f#$p/}"; src=
      case "$rel" in
       drive_c/windows/system32/xtajit64.dll) src="$BUILD/dlls/xtajit64/aarch64-windows/xtajit64.dll";;
       drive_c/windows/system32/xtajit.dll) src="$BUILD/dlls/xtajit/aarch64-windows/xtajit.dll";;
       drive_c/windows/system32/wow64.dll) src="$BUILD/dlls/wow64/aarch64-windows/wow64.dll";;
       drive_c/windows/system32/wow64win.dll) src="$BUILD/dlls/wow64win/aarch64-windows/wow64win.dll";;
       drive_c/windows/system32/d3d11.dll|drive_c/windows/system32/dxgi.dll)
         # Core prefixes may contain the Wine-built provider while graphics
         # profiles contain the preserved DXMT pair.  Select the source by
         # content so a core receipt never mislabels Wine bytes as DXMT.
         if test "$rel" = drive_c/windows/system32/d3d11.dll; then
           candidates="$ROOT/build/provider-preservation/pre-dxmt-cross-process-allow-20260731/d3d11.dll $BUILD/dlls/d3d11/aarch64-windows/d3d11.dll"
         else
           candidates="$ROOT/build/provider-preservation/pre-dxmt-cross-process-allow-20260731/dxgi.dll $BUILD/dlls/dxgi/aarch64-windows/dxgi.dll"
         fi
         for candidate in $candidates; do
           if test -f "$candidate" && test "$(sha "$candidate")" = "$(sha "$f")"; then src="$candidate"; break; fi
         done
         ;;
       drive_c/windows/syswow64/*.dll)
         # Several Wine test/support DLLs share a basename.  Select the exact
         # copied source by hash rather than the first matching pathname.
         base="$(basename "$f")"
         candidates="$(find "$BUILD/dlls" -type f -path "*/i386-windows/$base" -print)"
         case "$base" in
           d3d11.dll|dxgi.dll) candidates="$candidates $dxvk32/$base";;
           d3d12.dll|d3d12core.dll) candidates="$candidates $vkd3d32/$base";;
         esac
         for candidate in $candidates; do
           if test -f "$candidate" && test "$(sha "$candidate")" = "$(sha "$f")"; then src="$candidate"; break; fi
         done
         ;;
      esac
      test -n "$src" && test -f "$src" || die "no source mapping for $rel"
      printf '%s\t%s\t%s\n' "$rel" "$(sha "$f")" "${src#$ROOT/}"
    done < <({
      find "$p/drive_c/windows/system32" -maxdepth 1 -type f \
        \( -name xtajit64.dll -o -name xtajit.dll -o -name wow64.dll -o -name wow64win.dll -o -name d3d11.dll -o -name dxgi.dll \) -print
      find "$p/drive_c/windows/syswow64" -type f -name '*.dll' -print
    } | LC_ALL=C sort)
  } | atomic "$m"
}
write_meta() {
  local p="$1" q="$2" m="$(meta "$1")"
  mkdir -p "$m"; manifest "$p"
  cat <<EOF | atomic "$m/environment.sh"
export VKMT_RUNTIME_ROOT='$ROOT'
export WINEBUILDDIR='$BUILD'
export WINEPREFIX='$p'
export WINEBOOTSTRAPMODE=1
export WINE_NO_EXPLORER=1
export FEX_TSOENABLED=0
export FEX_VECTORTSOENABLED=0
export FEX_MEMCPYSETTSOENABLED=0
source '$ROOT/scripts/vkmt-runtime-env.sh'
EOF
  printf 'schema=1\nwineboot_exit=0\ncreated_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" | atomic "$m/wineboot.status"
  printf '{"schema":1,"mutable_cache":"not-hashed","browser":"identity-only","managed":"identity-only"}\n' | atomic "$m/cache-state.json"
  python3 - "$p" "$q" "$ROOT" "$BUILD" "$m" <<'PY' | atomic "$m/receipt.json"
import hashlib,json,os,platform,subprocess,sys
p,q,r,b,m=sys.argv[1:]
def h(n): return hashlib.sha256(open(os.path.join(m,n),'rb').read()).hexdigest()
def g(d):
 try:return subprocess.check_output(["git","-C",d,"rev-parse","HEAD"],text=True).strip()
 except Exception:return "unavailable"
print(json.dumps({"schema":1,"profile":q,"prefix":p,"runtime_root":r,"build_root":b,
"host":{"uname_machine":platform.machine(),"rosetta":False},
"metadata":{n:h(n) for n in ["staged-files.manifest","environment.sh","wineboot.status","cache-state.json"]},
"components":{"wine":{"revision":g(os.path.join(r,"wine/wine-11.12"))},"fex":{"revision":g(os.path.join(r,"third_party/FEX-2607"))},
"browser":{"installed":False,"status":"identity-only"},"managed":{"installed":False,"status":"identity-only"}},
"installed_roots":["drive_c/windows/system32","drive_c/windows/syswow64",".vkmt"]},sort_keys=True,indent=2))
PY
}
sync_providers() {
  local p="$1" m="$(meta "$1")" xtajit64_source="$BUILD/dlls/xtajit64/aarch64-windows/xtajit64.dll" xtajit_source="$BUILD/dlls/xtajit/aarch64-windows/xtajit.dll"
  owned "$p"; host
  test -f "$xtajit64_source" || die "missing rebuilt ARM64EC provider: $xtajit64_source"
  test -f "$xtajit_source" || die "missing rebuilt ARM64/i386 provider: $xtajit_source"
  test -f "$p/drive_c/windows/system32/xtajit64.dll" || die "missing staged provider: xtajit64.dll"
  test -f "$p/drive_c/windows/system32/xtajit.dll" || die "missing staged provider: xtajit.dll"
  python3 - "$p" "$ROOT" "$xtajit64_source" "$xtajit_source" <<'PY'
import hashlib,json,os,sys,tempfile
p,root,xtajit64,xtajit=sys.argv[1:]
manifest=os.path.join(p,".vkmt","staged-files.manifest")
sources={
 "drive_c/windows/system32/xtajit64.dll": xtajit64,
 "drive_c/windows/system32/xtajit.dll": xtajit,
}
rows=[]; found=set()
for raw in open(manifest):
    line=raw.rstrip("\n")
    fields=line.split("\t")
    if fields[0] in sources:
        rel=fields[0]
        target=os.path.join(p,rel)
        source=sources[rel]
        target_hash=hashlib.sha256(open(target,"rb").read()).hexdigest()
        source_hash=hashlib.sha256(open(source,"rb").read()).hexdigest()
        if target_hash != source_hash:
            raise SystemExit("staged provider differs from current build: "+rel)
        fields[1:]=[target_hash,os.path.relpath(source,root)]
        found.add(rel)
    rows.append("\t".join(fields))
missing=set(sources)-found
if missing: raise SystemExit("provider manifest entries missing: "+",".join(sorted(missing)))
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(manifest),prefix=".staged-files.manifest.providers.",text=True)
with os.fdopen(fd,"w") as out: out.write("\n".join(rows)+"\n")
os.replace(tmp,manifest)
receipt=os.path.join(p,".vkmt","receipt.json")
data=json.load(open(receipt))
data["metadata"]["staged-files.manifest"]=hashlib.sha256(open(manifest,"rb").read()).hexdigest()
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(receipt),prefix=".receipt.providers.",text=True)
with os.fdopen(fd,"w") as out: json.dump(data,out,sort_keys=True,indent=2); out.write("\n")
os.replace(tmp,receipt)
PY
  printf 'xtajit64_sha256=%s\nxtajit_sha256=%s\n' "$(sha "$p/drive_c/windows/system32/xtajit64.dll")" "$(sha "$p/drive_c/windows/system32/xtajit.dll")" >"$m/provider-sync.receipt"
}
verify() {
  local p="$1" m="$(meta "$1")" q rel expected src
  host; owned "$p"; test -f "$m/staged-files.manifest" || die "missing manifest"
  q="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["profile"])' "$m/receipt.json")"; profile "$q"
  while IFS=$'\t' read -r rel expected src; do
    test "$rel" = schema && continue
    test -f "$p/$rel" || die "missing staged file: $rel"
    test "$(sha "$p/$rel")" = "$expected" || die "tampered staged file: $rel"
    test -f "$ROOT/$src" && test "$(sha "$ROOT/$src")" = "$expected" || die "stale staged source: $src"
  done <"$m/staged-files.manifest"
  "$ROOT/scripts/stage-runtime-providers.sh" --verify-prefix "$p"
  if graphics "$q" && dxmt_enabled; then "$ROOT/scripts/stage-dxmt-runtime.sh" --verify-prefix "$p"; fi
  echo "VKMT_PREFIX_VERIFY_OK profile=$q prefix=$p"
}
cmd="${1:-}"; test -n "$cmd" || usage; shift
case "$cmd" in
 create)
  test "$#" = 4 && test "$1" = --profile && test "$3" = --prefix || usage; q="$2"; p="$(canon "$4")"; profile "$q"; safe "$p"; host
  test ! -e "$p" || test -z "$(find "$p" -mindepth 1 -maxdepth 1 -print -quit)" || die "create refuses nonempty prefix"
  mkdir -p "$p/.vkmt"; "$ROOT/scripts/stage-wine-host-libs.sh" "$BUILD"; "$ROOT/scripts/stage-runtime-providers.sh" --stage-only
  stage_closure "$p"; "$ROOT/scripts/stage-runtime-providers.sh" --prefix "$p"; if graphics "$q" && dxmt_enabled; then "$ROOT/scripts/stage-dxmt-runtime.sh" --prefix "$p"; fi
  WINEPREFIX="$p" WINEBUILDDIR="$BUILD" WINEBOOTSTRAPMODE=1 WINE_NO_EXPLORER=1 "$WINE" "$BOOT" --init >"$(meta "$p")/wineboot.log" 2>&1 || die "Wineboot failed; see $(meta "$p")/wineboot.log"
  stop "$p"; "$ROOT/scripts/stage-runtime-providers.sh" --prefix "$p"; if graphics "$q" && dxmt_enabled; then "$ROOT/scripts/stage-dxmt-runtime.sh" --prefix "$p"; fi
  write_meta "$p" "$q"; verify "$p"; echo "VKMT_PREFIX_CREATE_OK profile=$q prefix=$p";;
  sync-providers)
  test "$#" = 2 && test "$1" = --prefix || usage; p="$(canon "$2")"; safe "$p"; sync_providers "$p"; echo "VKMT_PREFIX_SYNC_PROVIDERS_OK prefix=$p";;
  sync-wow64)
  test "$#" = 2 && test "$1" = --prefix || usage; p="$(canon "$2")"; safe "$p"; owned "$p"
  source="$BUILD/dlls/wow64/aarch64-windows/wow64.dll"
  wow64win_source="$BUILD/dlls/wow64win/aarch64-windows/wow64win.dll"
  ntdll_source="$BUILD/dlls/ntdll/i386-windows/ntdll.dll"
  test -f "$source" || die "missing rebuilt WoW64 DLL: $source"
  test -f "$wow64win_source" || die "missing rebuilt WoW64 USER bridge: $wow64win_source"
  test -f "$ntdll_source" || die "missing rebuilt i386 ntdll: $ntdll_source"
  # Normal probes reuse the prepared prefix. Stage only the WoW64 closure
  # that can change with this source work; do not rehash/copy the entire
  # syswow64 tree on every Electron/CEF invocation.
  target="$p/drive_c/windows/system32/wow64.dll"
  wow64win_target="$p/drive_c/windows/system32/wow64win.dll"
  ntdll_target="$p/drive_c/windows/syswow64/ntdll.dll"
  install -m 0644 "$source" "$target"
  install -m 0644 "$wow64win_source" "$wow64win_target"
  install -m 0644 "$ntdll_source" "$ntdll_target"
  python3 - "$p" "$ROOT" "$source" "$wow64win_source" "$ntdll_source" <<'PY'
import hashlib,json,os,sys,tempfile
p,root,wow64,wow64win,ntdll=sys.argv[1:]
manifest=os.path.join(p,".vkmt","staged-files.manifest")
sources={
 "drive_c/windows/system32/wow64.dll": wow64,
 "drive_c/windows/system32/wow64win.dll": wow64win,
 "drive_c/windows/syswow64/ntdll.dll": ntdll,
}
rows=[]; found=set()
for raw in open(manifest):
    line=raw.rstrip("\n")
    fields=line.split("\t")
    if fields[0] in sources:
        src=sources[fields[0]]
        fields[1:]=[hashlib.sha256(open(src,"rb").read()).hexdigest(),os.path.relpath(src,root)]
        found.add(fields[0])
    rows.append("\t".join(fields))
missing=set(sources)-found
if missing: raise SystemExit("WoW64 manifest entries missing: "+",".join(sorted(missing)))
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(manifest),prefix=".staged-files.manifest.sync.",text=True)
with os.fdopen(fd,"w") as out: out.write("\n".join(rows)+"\n")
os.replace(tmp,manifest)
receipt=os.path.join(p,".vkmt","receipt.json")
data=json.load(open(receipt))
data["metadata"]["staged-files.manifest"]=hashlib.sha256(open(manifest,"rb").read()).hexdigest()
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(receipt),prefix=".receipt.sync.",text=True)
with os.fdopen(fd,"w") as out: json.dump(data,out,sort_keys=True,indent=2); out.write("\n")
os.replace(tmp,receipt)
PY
  if test "${VKMT_PREFIX_WINEBOOT_UPDATE:-0}" = 1; then
    WINEPREFIX="$p" WINEBUILDDIR="$BUILD" WINEBOOTSTRAPMODE=1 WINE_NO_EXPLORER=1 \
      "$WINE" "$BOOT" --update >"$(meta "$p")/wineboot-update.log" 2>&1
    stop "$p"
    stage_closure "$p"
    q="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["profile"])' "$(meta "$p")/receipt.json")"
    write_meta "$p" "$q"
  fi
  printf 'wow64_source=%s\nwow64_sha256=%s\nwineboot_update=%s\n' \
    "${source#$ROOT/}" "$(sha "$source")" "${VKMT_PREFIX_WINEBOOT_UPDATE:-0}" >"$(meta "$p")/wow64-sync.receipt"
  echo "VKMT_PREFIX_SYNC_WOW64_OK prefix=$p source=${source#$ROOT/} sha256=$(sha "$source") closure=wow64,wow64win,syswow64/ntdll.dll";;
 sync-dxmt)
  test "$#" = 2 && test "$1" = --prefix || usage; p="$(canon "$2")"; safe "$p"; owned "$p"
  "$ROOT/scripts/stage-dxmt-runtime.sh" --prefix "$p"
  python3 - "$p" "$ROOT" \
    "$ROOT/build/provider-preservation/pre-dxmt-cross-process-allow-20260731/d3d11.dll" \
    "$ROOT/build/provider-preservation/pre-dxmt-cross-process-allow-20260731/dxgi.dll" <<'PY'
import hashlib,json,os,sys,tempfile
p,root,d3d11,dxgi=sys.argv[1:]
manifest=os.path.join(p,".vkmt","staged-files.manifest")
sources={
 "drive_c/windows/system32/d3d11.dll":d3d11,
 "drive_c/windows/system32/dxgi.dll":dxgi,
}
rows=[]
found=set()
for raw in open(manifest):
    line=raw.rstrip("\n")
    fields=line.split("\t")
    if fields[0] in sources:
        source=sources[fields[0]]
        fields[1:]=[hashlib.sha256(open(source,"rb").read()).hexdigest(),os.path.relpath(source,root)]
        found.add(fields[0])
    rows.append("\t".join(fields))
missing=set(sources)-found
if missing: raise SystemExit("DXMT manifest entries missing: "+",".join(sorted(missing)))
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(manifest),prefix=".staged-files.manifest.sync.",text=True)
with os.fdopen(fd,"w") as out: out.write("\n".join(rows)+"\n")
os.replace(tmp,manifest)
receipt=os.path.join(p,".vkmt","receipt.json")
data=json.load(open(receipt))
data["metadata"]["staged-files.manifest"]=hashlib.sha256(open(manifest,"rb").read()).hexdigest()
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(receipt),prefix=".receipt.sync.",text=True)
with os.fdopen(fd,"w") as out: json.dump(data,out,sort_keys=True,indent=2); out.write("\n")
os.replace(tmp,receipt)
PY
  printf 'd3d11_sha256=%s\ndxgi_sha256=%s\n' "$(sha "$ROOT/build/provider-preservation/pre-dxmt-cross-process-allow-20260731/d3d11.dll")" "$(sha "$ROOT/build/provider-preservation/pre-dxmt-cross-process-allow-20260731/dxgi.dll")" >"$(meta "$p")/dxmt-sync.receipt"
  echo "VKMT_PREFIX_SYNC_DXMT_OK prefix=$p";;
 sync-graphics32)
  test "$#" = 2 && test "$1" = --prefix || usage; p="$(canon "$2")"; safe "$p"; owned "$p"
  q="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["profile"])' "$(meta "$p")/receipt.json")"
  graphics "$q" || die "sync-graphics32 requires a graphics/browser/full prefix"
  dxvk32="$ROOT/third_party/dxvk/runtime/dxvk-vkmt-1a5919b/x32"
  vkd3d32="$ROOT/third_party/vkd3d-proton/install-win32/bin"
  for f in "$dxvk32/d3d11.dll" "$dxvk32/dxgi.dll" "$vkd3d32/d3d12.dll" "$vkd3d32/d3d12core.dll"; do
    test -f "$f" || die "missing graphics32 provider: $f"
  done
  install -m 0644 "$dxvk32/d3d11.dll" "$dxvk32/dxgi.dll" \
    "$vkd3d32/d3d12.dll" "$vkd3d32/d3d12core.dll" "$p/drive_c/windows/syswow64/"
  # Keep this sync targeted. Rebuilding the complete WoW64 manifest here
  # hashes every i386 DLL and turns a four-file provider update into a
  # multi-minute prefix operation. The manifest already has one row per
  # staged file; update only the four rows whose source bytes changed.
  python3 - "$p" "$ROOT" "$dxvk32/d3d11.dll" "$dxvk32/dxgi.dll" \
    "$vkd3d32/d3d12.dll" "$vkd3d32/d3d12core.dll" <<'PY'
import hashlib, json, os, sys, tempfile
p, root, d3d11, dxgi, d3d12, d3d12core = sys.argv[1:]
manifest = os.path.join(p, ".vkmt", "staged-files.manifest")
sources = {
    "drive_c/windows/syswow64/d3d11.dll": d3d11,
    "drive_c/windows/syswow64/dxgi.dll": dxgi,
    "drive_c/windows/syswow64/d3d12.dll": d3d12,
    "drive_c/windows/syswow64/d3d12core.dll": d3d12core,
}
rows = []
found = set()
for raw in open(manifest):
    fields = raw.rstrip("\n").split("\t")
    if fields[0] in sources:
        source = sources[fields[0]]
        digest = hashlib.sha256(open(source, "rb").read()).hexdigest()
        target = os.path.join(p, fields[0])
        if hashlib.sha256(open(target, "rb").read()).hexdigest() != digest:
            raise SystemExit("staged graphics32 provider hash mismatch: " + fields[0])
        fields[1:] = [digest, os.path.relpath(source, root)]
        found.add(fields[0])
    rows.append("\t".join(fields))
missing = set(sources) - found
if missing:
    raise SystemExit("graphics32 manifest entries missing: " + ",".join(sorted(missing)))
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(manifest), prefix=".staged-files.manifest.graphics32.", text=True)
with os.fdopen(fd, "w") as out:
    out.write("\n".join(rows) + "\n")
os.replace(tmp, manifest)
receipt = os.path.join(p, ".vkmt", "receipt.json")
data = json.load(open(receipt))
data["metadata"]["staged-files.manifest"] = hashlib.sha256(open(manifest, "rb").read()).hexdigest()
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(receipt), prefix=".receipt.graphics32.", text=True)
with os.fdopen(fd, "w") as out:
    json.dump(data, out, sort_keys=True, indent=2)
    out.write("\n")
os.replace(tmp, receipt)
PY
  printf 'dxvk_d3d11_sha256=%s\ndxvk_dxgi_sha256=%s\nvkd3d_d3d12_sha256=%s\nvkd3d_d3d12core_sha256=%s\n' \
    "$(sha "$dxvk32/d3d11.dll")" "$(sha "$dxvk32/dxgi.dll")" \
    "$(sha "$vkd3d32/d3d12.dll")" "$(sha "$vkd3d32/d3d12core.dll")" >"$(meta "$p")/graphics32-sync.receipt"
  echo "VKMT_PREFIX_SYNC_GRAPHICS32_OK prefix=$p";;
 refresh|verify|warm|reset|destroy)
  test "$#" = 2 && test "$1" = --prefix || usage; p="$(canon "$2")"; safe "$p"
  if test "$cmd" = refresh; then
    owned "$p"; host; q="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["profile"])' "$(meta "$p")/receipt.json")"; profile "$q"
    stage_closure "$p"; "$ROOT/scripts/stage-runtime-providers.sh" --prefix "$p"
    if graphics "$q" && dxmt_enabled; then "$ROOT/scripts/stage-dxmt-runtime.sh" --prefix "$p"; fi
    stop "$p"; write_meta "$p" "$q"; verify "$p"; echo "VKMT_PREFIX_REFRESH_OK profile=$q prefix=$p"
  elif test "$cmd" = verify; then verify "$p"
  elif test "$cmd" = warm; then verify "$p"; "$ROOT/scripts/vkmt-warm-session.sh" warm --prefix "$p"; WINEPREFIX="$p" WINEBUILDDIR="$BUILD" "$WINE" cmd /c exit 0; echo VKMT_PREFIX_WARM_OK
  elif test "$cmd" = reset; then owned "$p"; q="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["profile"])' "$(meta "$p")/receipt.json")"; stop "$p"; rm -rf "$p"; "$0" create --profile "$q" --prefix "$p"
  else owned "$p"; stop "$p"; rm -rf "$p"; echo VKMT_PREFIX_DESTROY_OK; fi;;
 run)
  test "$#" -ge 4 && test "$1" = --prefix || usage; p="$(canon "$2")"; shift 2; stale=0; test "${1:-}" != --allow-stale || { stale=1; shift; }; test "${1:-}" = -- || usage; shift
  safe "$p"; test "$stale" = 1 && echo VKMT_PREFIX_STALE_OVERRIDE=1 >&2 || verify "$p"
  exec env WINEPREFIX="$p" WINEBUILDDIR="$BUILD" WINEBOOTSTRAPMODE=1 WINE_NO_EXPLORER=1 FEX_TSOENABLED=0 FEX_VECTORTSOENABLED=0 FEX_MEMCPYSETTSOENABLED=0 "$WINE" "$@";;
 *) usage;;
esac
