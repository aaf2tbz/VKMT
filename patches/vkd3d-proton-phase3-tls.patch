--- a/libs/vkd3d/address_binding_tracker.c
+++ b/libs/vkd3d/address_binding_tracker.c
@@ -26,13 +26,54 @@
 
 /* If we receive out of band BIND/UNBINDs, we assume they are for sparse binds
  * as they would be triggered from submission threads.
- * Otherwise, BindBufferMemory and BindImageMemory must trigger callbacks inline. */
-static VKD3D_THREAD_LOCAL bool vkd3d_address_binding_is_user_thread;
+ * Otherwise, BindBufferMemory and BindImageMemory must trigger callbacks inline.
+ *
+ * Do not use PE image TLS here.  On the VKMT ARM64/ARM64EC Wine boundary the
+ * compiler-generated access reads the native x18 TLS pointer, which is not
+ * populated by the guest. */
+#ifdef _WIN32
+static DWORD address_binding_tls_index = TLS_OUT_OF_INDEXES;
+static INIT_ONCE address_binding_tls_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK address_binding_tls_init(PINIT_ONCE once, PVOID parameter, PVOID *context)
+{
+    (void)once;
+    (void)parameter;
+    (void)context;
+    address_binding_tls_index = TlsAlloc();
+    return address_binding_tls_index != TLS_OUT_OF_INDEXES;
+}
 
-void vkd3d_address_binding_tracker_mark_user_thread(void)
+static bool address_binding_is_user_thread(void)
+{
+    BOOL initialized = InitOnceExecuteOnce(&address_binding_tls_once,
+            address_binding_tls_init, NULL, NULL);
+    return initialized && TlsGetValue(address_binding_tls_index) != NULL;
+}
+
+static void address_binding_set_user_thread(void)
+{
+    if (InitOnceExecuteOnce(&address_binding_tls_once, address_binding_tls_init, NULL, NULL))
+        TlsSetValue(address_binding_tls_index, (void *)1);
+}
+#else
+static __thread bool vkd3d_address_binding_is_user_thread;
+
+static bool address_binding_is_user_thread(void)
+{
+    return vkd3d_address_binding_is_user_thread;
+}
+
+static void address_binding_set_user_thread(void)
 {
     vkd3d_address_binding_is_user_thread = true;
 }
+#endif
+
+void vkd3d_address_binding_tracker_mark_user_thread(void)
+{
+    address_binding_set_user_thread();
+}
 
