diff --git a/libs/vkd3d-common/debug.c b/libs/vkd3d-common/debug.c
index 32503a85..34e90cc4 100644
--- a/libs/vkd3d-common/debug.c
+++ b/libs/vkd3d-common/debug.c
@@ -263,14 +263,58 @@ void vkd3d_dbg_printf(enum vkd3d_dbg_channel channel, enum vkd3d_dbg_level level
     va_end(args);
 }
 
+struct vkd3d_debug_tls
+{
+    char buffers[VKD3D_DEBUG_BUFFER_COUNT][VKD3D_DEBUG_BUFFER_SIZE];
+    size_t buffer_index;
+};
+
+#ifdef _WIN32
+static DWORD vkd3d_debug_tls_index = TLS_OUT_OF_INDEXES;
+static INIT_ONCE vkd3d_debug_tls_once = INIT_ONCE_STATIC_INIT;
+static struct vkd3d_debug_tls vkd3d_debug_tls_fallback;
+
+static BOOL CALLBACK vkd3d_debug_tls_init(PINIT_ONCE once, PVOID parameter, PVOID *context)
+{
+    (void)once;
+    (void)parameter;
+    (void)context;
+    vkd3d_debug_tls_index = TlsAlloc();
+    return vkd3d_debug_tls_index != TLS_OUT_OF_INDEXES;
+}
+
+static struct vkd3d_debug_tls *vkd3d_get_debug_tls(void)
+{
+    struct vkd3d_debug_tls *tls;
+
+    if (!InitOnceExecuteOnce(&vkd3d_debug_tls_once, vkd3d_debug_tls_init, NULL, NULL))
+        return &vkd3d_debug_tls_fallback;
+    if ((tls = TlsGetValue(vkd3d_debug_tls_index)))
+        return tls;
+    tls = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*tls));
+    if (!tls || !TlsSetValue(vkd3d_debug_tls_index, tls))
+    {
+        if (tls) HeapFree(GetProcessHeap(), 0, tls);
+        return &vkd3d_debug_tls_fallback;
+    }
+    return tls;
+}
+#else
+static __thread struct vkd3d_debug_tls vkd3d_debug_tls_storage;
+
+static struct vkd3d_debug_tls *vkd3d_get_debug_tls(void)
+{
+    return &vkd3d_debug_tls_storage;
+}
+#endif
+
 static char *get_buffer(void)
 {
-    static VKD3D_THREAD_LOCAL char buffers[VKD3D_DEBUG_BUFFER_COUNT][VKD3D_DEBUG_BUFFER_SIZE];
-    static VKD3D_THREAD_LOCAL size_t buffer_index;
+    struct vkd3d_debug_tls *tls = vkd3d_get_debug_tls();
     size_t current_index;
 
-    current_index = (++buffer_index) % ARRAY_SIZE(buffers);
-    return buffers[current_index];
+    current_index = (++tls->buffer_index) % ARRAY_SIZE(tls->buffers);
+    return tls->buffers[current_index];
 }
 
