index f7a122b..69ccbf8 100644
--- a/src/winemetal/unix/cache.c
+++ b/src/winemetal/unix/cache.c
@@ -231,8 +231,20 @@ _WMTSetMetalShaderCachePath(void *obj) {
   struct unixcall_setmetalcachepath *params = obj;
   NSString *path = [[NSString alloc] initWithCString:params->path.ptr encoding:NSUTF8StringEncoding];
   NSString *resolved_path = resolve_cache_dir(path, false);
-  MTLSetShaderCachePath(resolved_path);
-  params->ret_success = [MTLGetShaderCachePath() isEqualToString:resolved_path];
+  if (!resolved_path) {
+    params->ret_success = 0;
+    [path release];
+    return 0;
+  }
+  resolved_path = [[resolved_path stringByStandardizingPath] stringByResolvingSymlinksInPath];
+  /* The Wine macOS driver has already selected this cache before any Metal
+   * device exists.  Re-applying it after Metal initialization is rejected on
+   * current macOS releases, so accept the active equivalent cache first. */
+  NSString *active_path = [[MTLGetShaderCachePath() stringByStandardizingPath] stringByResolvingSymlinksInPath];
+  if (![active_path isEqualToString:resolved_path])
+    MTLSetShaderCachePath(resolved_path);
+  active_path = [[MTLGetShaderCachePath() stringByStandardizingPath] stringByResolvingSymlinksInPath];
+  params->ret_success = [active_path isEqualToString:resolved_path];
   [path release];
   return 0;
 };
