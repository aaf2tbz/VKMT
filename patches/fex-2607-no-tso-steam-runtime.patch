 namespace FEX::Windows {
+/*
+ * Validate the effective, fully layered FEX configuration at the provider
+ * boundary.  The VKMT no-TSO gate must prove what the provider loaded rather
+ * than trusting the launcher's environment.  Keep the attachment record to
+ * one line per process so large child-process fixtures cannot create an
+ * unbounded diagnostic stream.
+ */
+static inline void ValidateNoTSOContract(const char* Provider, std::string_view ExecutableName, bool EmitAttachment = true) {
+  const bool TSOEnabled = FEXCore::Config::Get_TSOENABLED()();
+  const bool VectorTSOEnabled = FEXCore::Config::Get_VECTORTSOENABLED()();
+  const bool MemcpySetTSOEnabled = FEXCore::Config::Get_MEMCPYSETTSOENABLED()();
+  if (EmitAttachment) {
+    LogMan::Msg::IFmt(
+      "VKMT_NO_TSO provider={} executable={} pid={} process_creation=1 provider_attachment=1 tso={} vector_tso={} memcpyset_tso={}",
+      Provider, ExecutableName, GetCurrentProcessId(), TSOEnabled, VectorTSOEnabled, MemcpySetTSOEnabled);
+  }
+
+  if (TSOEnabled || VectorTSOEnabled || MemcpySetTSOEnabled) [[unlikely]] {
+    LogMan::Msg::EFmt("VKMT no-TSO contract violated: provider={} executable={} tso={} vector_tso={} memcpyset_tso={}",
+                      Provider, ExecutableName, TSOEnabled, VectorTSOEnabled, MemcpySetTSOEnabled);
+    // LOGMAN_THROW_A_FMT is intentionally compiled out in release builds.
+    // This is a runtime contract, not a debug assertion, so reject the
+    // provider unconditionally before it can execute a guest instruction.
+    FEX_TRAP_EXECUTION;
+  }
+}
