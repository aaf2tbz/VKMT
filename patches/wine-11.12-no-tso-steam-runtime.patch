+static BOOL use_steam_wait_poll(void)
+{
+    UNICODE_STRING steam = RTL_CONSTANT_STRING( L"steam.exe" );
+    UNICODE_STRING worker = RTL_CONSTANT_STRING( L"CHTTPClientThreadPool:0" );
+    UNICODE_STRING recovery_name = RTL_CONSTANT_STRING( L"VKMT_STEAM_BOOTSTRAP_WAKE_RECOVERY" );
