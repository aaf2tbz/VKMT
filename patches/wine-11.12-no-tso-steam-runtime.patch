diff --git a/server/mapping.c b/server/mapping.c
index a53b6b6..5cf7139 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1751,6 +1751,8 @@ DECL_HANDLER(map_image_view)
 
     if ((view = mem_alloc( sizeof(*view) )))
     {
+        int native_managed, native_ilonly64;
+
         view->base      = req->base;
         view->size      = req->size;
         view->flags     = mapping->flags;
@@ -1760,16 +1762,20 @@ DECL_HANDLER(map_image_view)
         view->committed = NULL;
         view->shared    = mapping->shared ? (struct shared_map *)grab_object( mapping->shared ) : NULL;
         view->image     = mapping->image;
+        native_ilonly64 = (view->image.image_flags & IMAGE_FLAGS_ComPlusILOnly) &&
+                          is_machine_64bit( view->image.machine ) &&
+                          is_machine_64bit( native_machine );
+        native_managed = (view->image.image_flags & IMAGE_FLAGS_ComPlusNativeReady) ||
+                         native_ilonly64;
         if (add_process_view( current, view ))
         {
             current->entry_point = view->base + req->entry;
-            current->process->machine = (view->image.image_flags & IMAGE_FLAGS_ComPlusNativeReady) ?
-                                         native_machine : req->machine;
+            current->process->machine = native_managed ? native_machine : req->machine;
         }
 
         if (view->base != (mapping->image.map_addr ? mapping->image.map_addr : mapping->image.base) + req->offset)
             set_error( STATUS_IMAGE_NOT_AT_BASE );
-        if (req->machine != current->process->machine)
+        if (!native_ilonly64 && req->machine != current->process->machine)
         {
             /* on 32-bit, the native 64-bit machine is allowed */
             if (is_machine_64bit( current->process->machine ) || req->machine != native_machine)
