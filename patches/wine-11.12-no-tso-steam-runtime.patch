diff --git a/dlls/msvcrt/main.c b/dlls/msvcrt/main.c
index 39c20b2..7ba7275 100644
--- a/dlls/msvcrt/main.c
+++ b/dlls/msvcrt/main.c
@@ -87,7 +87,7 @@ static inline void msvcrt_free_tls_mem(void)
 /*********************************************************************
  *                  Init
  */
-BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
+static BOOL msvcrt_dll_main(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
 {
   TRACE("(%p, %s, %p) pid(%lx), tid(%lx), tls(%lu)\n",
         hinstDLL, msvcrt_get_reason(fdwReason), lpvReserved,
@@ -174,3 +174,51 @@ BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
   }
   return TRUE;
 }
+
+#ifdef __arm64ec__
+
+/*
+ * ARM64X images contain separate native ARM64 and ARM64EC data sections.
+ * The PE loader calls the native entry point, while x64 fast-forward exports
+ * execute the ARM64EC code and therefore use the ARM64EC copy of the CRT
+ * state.  Expose a uniquely named entry point so the native DllMain can
+ * forward loader notifications to that second data domain.
+ */
+BOOL WINAPI msvcrt_arm64ec_DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
+{
+    return msvcrt_dll_main(hinstDLL, fdwReason, lpvReserved);
+}
+
+#elif defined(__aarch64__)
+
+extern BOOL WINAPI msvcrt_arm64ec_DllMain(HINSTANCE, DWORD, LPVOID)
+    __asm__("#msvcrt_arm64ec_DllMain") __attribute__((weak));
+
+#endif
+
+BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved)
+{
+#if defined(__aarch64__) && !defined(__arm64ec__)
+    BOOL ret;
+
+    if (fdwReason == DLL_PROCESS_DETACH || fdwReason == DLL_THREAD_DETACH)
+    {
+        if (msvcrt_arm64ec_DllMain)
+            msvcrt_arm64ec_DllMain(hinstDLL, fdwReason, lpvReserved);
+        return msvcrt_dll_main(hinstDLL, fdwReason, lpvReserved);
+    }
+
+    if (!(ret = msvcrt_dll_main(hinstDLL, fdwReason, lpvReserved)))
+        return FALSE;
+    if (msvcrt_arm64ec_DllMain &&
+        !msvcrt_arm64ec_DllMain(hinstDLL, fdwReason, lpvReserved))
+    {
+        if (fdwReason == DLL_PROCESS_ATTACH)
+            msvcrt_dll_main(hinstDLL, DLL_PROCESS_DETACH, NULL);
+        return FALSE;
+    }
+    return TRUE;
+#else
+    return msvcrt_dll_main(hinstDLL, fdwReason, lpvReserved);
+#endif
+}
