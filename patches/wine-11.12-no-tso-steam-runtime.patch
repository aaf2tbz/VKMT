+        return FALSE;
+
+    image = params->ImagePathName;
+    if (!image.Buffer || !image.Length) return FALSE;
+
+    name = image.Buffer;
+    end = name + image.Length / sizeof(WCHAR);
+    while (end > name && end[-1] != '\\' && end[-1] != '/') --end;
+
+    basename.Buffer = end;
+    basename.Length = (name + image.Length / sizeof(WCHAR) - end) * sizeof(WCHAR);
+    basename.MaximumLength = basename.Length;
+    if (!RtlEqualUnicodeString( &basename, &steam, TRUE )) return FALSE;
