+static BOOL steam_bootstrap_is_downloading( UNICODE_STRING *nt_log )
+{
+    static const char *const states[] =
+    {
+        "Checking for available updates", "Downloading update", "Extracting package",
+        "Installing update", "Update complete", "Shutdown"
+    };
+    FILE_STANDARD_INFORMATION info;
+    IO_STATUS_BLOCK io;
+    OBJECT_ATTRIBUTES attr;
+    LARGE_INTEGER offset;
+    char buffer[4097], *state, *match;
+    HANDLE file;
+    unsigned int i, last = 0;
+    ULONG size;
+
+    InitializeObjectAttributes( &attr, nt_log, OBJ_CASE_INSENSITIVE, NULL, NULL );
+    if (NtOpenFile( &file, GENERIC_READ | SYNCHRONIZE, &attr, &io,
+                    FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                    FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE ))
+        return FALSE;
+    if (NtQueryInformationFile( file, &io, &info, sizeof(info), FileStandardInformation ) ||
+        info.EndOfFile.QuadPart <= 0)
+    {
+        NtClose( file );
+        return FALSE;
+    }
+
+    size = min( info.EndOfFile.QuadPart, sizeof(buffer) - 1 );
+    offset.QuadPart = info.EndOfFile.QuadPart - size;
+    if (NtReadFile( file, NULL, NULL, NULL, &io, buffer, size, &offset, NULL ))
+    {
+        NtClose( file );
+        return FALSE;
+    }
+    NtClose( file );
+    buffer[io.Information] = 0;
+
+    /* The newest state in the log is authoritative; old update lines remain. */
+    state = buffer;
+    for (i = 0; i < ARRAY_SIZE(states); ++i)
+        for (match = strstr( buffer, states[i] ); match; match = strstr( match + 1, states[i] ))
+            if (match >= state) state = match, last = i;
+
+    return last == 1;
