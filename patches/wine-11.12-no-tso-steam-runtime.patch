+++ b/dlls/kernelbase/process.c
@@ -504,6 +504,31 @@ done:
 /**********************************************************************
  *           CreateProcessInternalW   (kernelbase.@)
  */
+static void disable_steam_stack_profiler( const WCHAR *app_name, WCHAR *cmd_line )
+{
+    static const WCHAR webhelperW[] = L"steamwebhelper";
+    static const WCHAR profilerW[] = L" --start-stack-profiler";
+    WCHAR disable_profiler[2], *profiler;
+
+    /* Chromium's stack sampler continuously suspends and resumes translated
+     * ARM64EC threads under Wine.  Steam enables it in GPU, network, and
+     * renderer children; it can starve the initial Mojo invitation and turn a
+     * normal parent/child launch into a multi-minute handoff.  This telemetry
+     * feature is not required for rendering.  Keep the workaround opt-in and
+     * scoped to Steam WebHelper children so native process semantics remain
+     * unchanged for every other application. */
+    if (!cmd_line ||
+        !((app_name && wcsstr( app_name, webhelperW )) || wcsstr( cmd_line, webhelperW )) ||
+        GetEnvironmentVariableW( L"VKMT_STEAM_DISABLE_STACK_PROFILER",
+                                 disable_profiler, ARRAY_SIZE(disable_profiler) ) != 1 ||
+        disable_profiler[0] != '1' || !(profiler = wcsstr( cmd_line, profilerW )))
+        return;
+
+    memmove( profiler, profiler + ARRAY_SIZE(profilerW) - 1,
+             (lstrlenW( profiler + ARRAY_SIZE(profilerW) - 1 ) + 1) * sizeof(WCHAR) );
+    WARN( "VKMT disabled Steam WebHelper stack sampling for translated child.\n" );
+}
