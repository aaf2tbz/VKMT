+    ret = steam_bootstrap_is_downloading( &nt_log );
+    RtlFreeUnicodeString( &nt_log );
+    return ret;
+}
+
+static BOOL steam_bootstrap_stalled(void)
+{
+    FILE_BASIC_INFORMATION info;
+    OBJECT_ATTRIBUTES attr;
+    LARGE_INTEGER now;
+    UNICODE_STRING nt_log;
+
+    if (!steam_get_bootstrap_log( &nt_log )) return FALSE;
+    InitializeObjectAttributes( &attr, &nt_log, OBJ_CASE_INSENSITIVE, NULL, NULL );
+
+    if (NtQueryAttributesFile( &attr, &info ) || NtQuerySystemTime( &now ))
+    {
+        RtlFreeUnicodeString( &nt_log );
+        return FALSE;
+    }
+    /*
+     * Wake only the frozen download worker. Once the newest state advances to
+     * extraction (or any other state), polling and synthetic wakes stop.
+     */
+    if (now.QuadPart < info.LastWriteTime.QuadPart + 30000000 ||
+        !steam_bootstrap_is_downloading( &nt_log ))
+    {
+        RtlFreeUnicodeString( &nt_log );
+        return FALSE;
+    }
+    RtlFreeUnicodeString( &nt_log );
+    return TRUE;
+}
