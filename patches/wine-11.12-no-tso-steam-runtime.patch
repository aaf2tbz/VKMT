+/* Steam's bootstrapper can finish applying an update but strand the process
+ * before its successor is launched.  Keep this notification entirely on the
+ * native Unix side: matching guest bytes here avoids Winsock recursion and
+ * the acquire/release atomic is valid without Apple's TSO facility. */
+static int steam_handoff_notify_state;
+
+static BOOL buffer_contains( const void *buffer, size_t length,
+                             const char *needle, size_t needle_length )
+{
+    const unsigned char *bytes = buffer;
+    size_t i;
+
+    if (length < needle_length) return FALSE;
+    for (i = 0; i <= length - needle_length; ++i)
+        if (!memcmp( bytes + i, needle, needle_length )) return TRUE;
+    return FALSE;
+}
+
+static void notify_steam_handoff( const void *buffer, size_t length )
+{
+    static const char marker[] = "Update complete, launching Steam...";
+    static const char request[] =
+        "POST /steam/handoff HTTP/1.1\r\n"
+        "Host: 127.0.0.1:9274\r\n"
+        "Content-Length: 0\r\n"
+        "Connection: close\r\n\r\n";
+    struct sockaddr_in address = {0};
+    const char *enabled, *port_env;
+    unsigned long port = 9274;
+    int expected = 0, socket_fd;
+    size_t request_sent = 0;
+#ifdef SO_NOSIGPIPE
+    int no_sigpipe = 1;
+#endif
+
+    if (!(enabled = getenv( "VKMT_STEAM_HANDOFF_NOTIFY" )) || strcmp( enabled, "1" )) return;
+    if (!buffer_contains( buffer, length, marker, sizeof(marker) - 1 )) return;
+
+    if (!__atomic_compare_exchange_n( &steam_handoff_notify_state, &expected, 1, FALSE,
+                                      __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE )) return;
+
+    if ((port_env = getenv( "VKMT_STEAM_HANDOFF_PORT" )))
+    {
+        char *end;
+        unsigned long value = strtoul( port_env, &end, 10 );
+        if (end != port_env && !*end && value && value <= 65535) port = value;
+    }
+
+    socket_fd = socket( AF_INET, SOCK_STREAM, 0 );
+    if (socket_fd == -1) goto failed;
+#ifdef SO_NOSIGPIPE
+    setsockopt( socket_fd, SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe) );
+#endif
+    address.sin_family = AF_INET;
+    address.sin_port = htons( port );
+    address.sin_addr.s_addr = htonl( INADDR_LOOPBACK );
+    if (connect( socket_fd, (struct sockaddr *)&address, sizeof(address) ) == -1)
+    {
+        close( socket_fd );
+        goto failed;
+    }
+    while (request_sent < sizeof(request) - 1)
+    {
+        ssize_t sent = send( socket_fd, request + request_sent,
+                             sizeof(request) - 1 - request_sent, 0 );
+        if (sent > 0) request_sent += sent;
+        else if (sent == -1 && errno == EINTR) continue;
+        else break;
+    }
+    close( socket_fd );
+    if (request_sent != sizeof(request) - 1) goto failed;
+
+    __atomic_store_n( &steam_handoff_notify_state, 2, __ATOMIC_RELEASE );
+    return;
+
+failed:
+    /* A failed connection is not a published handoff.  Permit a later exact
+     * marker write to retry instead of consuming this process's one shot. */
+    __atomic_store_n( &steam_handoff_notify_state, 0, __ATOMIC_RELEASE );
+}
+
 #define MAX_DOS_DRIVES 26
 
 /* just in case... */
