+static BOOL steam_get_bootstrap_log( UNICODE_STRING *nt_log )
+{
+    static const WCHAR suffix[] = L"logs\\bootstrap_log.txt";
+    RTL_USER_PROCESS_PARAMETERS *params;
+    UNICODE_STRING image;
+    WCHAR path[1024], *name, *end;
+    SIZE_T directory_len, suffix_len = ARRAY_SIZE(suffix) - 1;
+
+    if (!NtCurrentTeb()->Peb || !(params = NtCurrentTeb()->Peb->ProcessParameters))
+        return FALSE;
+    image = params->ImagePathName;
+    if (!image.Buffer || !image.Length) return FALSE;
+
+    name = image.Buffer;
+    end = name + image.Length / sizeof(WCHAR);
+    while (end > name && end[-1] != '\\' && end[-1] != '/') --end;
+    directory_len = end - name;
+    if (directory_len + suffix_len >= ARRAY_SIZE(path)) return FALSE;
+
+    memcpy( path, name, directory_len * sizeof(WCHAR) );
+    memcpy( path + directory_len, suffix, (suffix_len + 1) * sizeof(WCHAR) );
+    return RtlDosPathNameToNtPathName_U( path, nt_log, NULL, NULL );
