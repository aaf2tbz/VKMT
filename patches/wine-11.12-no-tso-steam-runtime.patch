+/* Steam's 2026-07-24 chrome_elf statically links a UCRT _read_nolock path
+ * which fast-fails after Wine correctly reports an invalid descriptor.  The
+ * instruction following the call already returns -1, matching the CRT
+ * contract.  Patch only the exact known image after it is mapped; mutating the
+ * file on disk makes Steam's verifier reinstall the client on every launch. */
+static void patch_steam_chrome_elf_invalid_read( void *module, const WINE_MODREF *wm )
+{
+    static const BYTE expected[] = {0xe8, 0x32, 0xec, 0x00, 0x00};
+    static const BYTE replacement[] = {0x90, 0x90, 0x90, 0x90, 0x90};
+    IMAGE_NT_HEADERS *nt = RtlImageNtHeader( module );
+    void *target, *protect_base;
+    SIZE_T protect_size;
+    ULONG old_prot;
+
+    if (!nt || wcsicmp( wm->ldr.BaseDllName.Buffer, L"chrome_elf.dll" ) ||
+        nt->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64 ||
+        nt->FileHeader.TimeDateStamp != 0x66956fee ||
+        nt->OptionalHeader.SizeOfImage != 0x166000 ||
+        nt->OptionalHeader.CheckSum != 0x15a09a)
+        return;
+
+    target = (BYTE *)module + 0x9352d;
+    if (memcmp( target, expected, sizeof(expected) ))
+    {
+        WARN( "VKMT refused unknown Steam chrome_elf invalid-read bytes.\n" );
+        return;
+    }
+
+    protect_base = target;
+    protect_size = sizeof(expected);
+    if (NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size,
+                                PAGE_EXECUTE_READWRITE, &old_prot ))
+    {
+        WARN( "VKMT could not make Steam chrome_elf invalid-read path writable.\n" );
+        return;
+    }
+    memcpy( target, replacement, sizeof(replacement) );
+    NtFlushInstructionCache( NtCurrentProcess(), target, sizeof(replacement) );
+    NtProtectVirtualMemory( NtCurrentProcess(), &protect_base, &protect_size,
+                            old_prot, &old_prot );
+    WARN( "VKMT patched Steam chrome_elf invalid-read path in memory.\n" );
+}
