+# VKMT: LLVM's Windows TLS lowering hardcodes [x18,#0x58], but on Darwin PE
+# keeps the TEB in x28. Rewrite the operands in every freshly linked PE dll.
+if vkd3d_platform == 'windows' and host_machine.cpu_family() == 'aarch64'
+  custom_target('fix-x18-tls',
+    input   : [d3d12core_lib, d3d12_lib],
+    output  : 'fix-x18-tls.stamp',
+    command : ['sh', '-c', 'python3 /Volumes/AverySSD/VKMT/scripts/fix-x18-tls.py "$@" && touch "$0"', '@OUTPUT@', '@INPUT@'],
+    build_by_default : true)
+endif
+
