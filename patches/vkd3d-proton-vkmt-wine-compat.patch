diff --git a/subprojects/dxil-spirv/util/vkmt_thread_local.hpp b/subprojects/dxil-spirv/util/vkmt_thread_local.hpp
new file mode 100644
index 00000000..8d86ea14
--- /dev/null
+++ b/subprojects/dxil-spirv/util/vkmt_thread_local.hpp
@@ -0,0 +1,94 @@
+/*
+ * VKMT ARM64/FEX-safe thread-local storage.
+ *
+ * The Windows ARM64 ABI reserves x18 for the platform TLS pointer.  The
+ * MinGW C++ thread_local implementation consequently emits an x18-relative
+ * access even when the rest of a DLL is compiled with -ffixed-x18.  Wine's
+ * ARM64 guest boundary does not provide that native Windows register value;
+ * using such a variable from DXIL-SPIRV crashes before a graphics pipeline
+ * can be created.  Use the Win32 TLS API for Windows builds instead.  The
+ * non-Windows implementation remains a normal C++ thread_local so this
+ * helper does not change native tooling behavior.
+ */
+#pragma once
+
+#if defined(_WIN32)
+# define WIN32_LEAN_AND_MEAN
+# include <windows.h>
+#endif
+
+#include <cstring>
+
+namespace dxil_spv
+{
+template <typename T>
+class vkmt_thread_local
+{
+public:
+    vkmt_thread_local() noexcept
+#if defined(_WIN32)
+        : index_(TLS_OUT_OF_INDEXES), once_(INIT_ONCE_STATIC_INIT)
+#endif
+    {
+#if !defined(_WIN32)
+        value_ = T();
+#endif
+    }
+
+    T &get() const noexcept
+    {
+#if defined(_WIN32)
+        DWORD index = get_index();
+        if (index == TLS_OUT_OF_INDEXES)
+            return fallback();
+
+        void *storage = TlsGetValue(index);
+        if (!storage)
+        {
+            storage = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(T));
+            if (!storage || !TlsSetValue(index, storage))
+            {
+                if (storage) HeapFree(GetProcessHeap(), 0, storage);
+                return fallback();
+            }
+        }
+        return *static_cast<T *>(storage);
+#else
+        return value_;
+#endif
+    }
+
+    void set(const T &value) const noexcept
+    {
+        get() = value;
+    }
+
+private:
+#if defined(_WIN32)
+    static BOOL CALLBACK initialize(PINIT_ONCE, PVOID parameter, PVOID *)
+    {
+        vkmt_thread_local *self = static_cast<vkmt_thread_local *>(parameter);
+        self->index_ = TlsAlloc();
+        return self->index_ != TLS_OUT_OF_INDEXES;
+    }
+
+    DWORD get_index() const noexcept
+    {
+        InitOnceExecuteOnce(const_cast<PINIT_ONCE>(&once_), initialize,
+                const_cast<vkmt_thread_local *>(this), NULL);
+        return index_;
+    }
+
+    static T &fallback() noexcept
+    {
+        static T value = T();
+        return value;
+    }
+
+    mutable DWORD index_;
+    mutable INIT_ONCE once_;
+#else
+    mutable T value_;
+#endif
+};
+}
