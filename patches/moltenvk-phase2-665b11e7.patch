+	pXFBProps->maxTransformFeedbackBuffers = 0;
+	pXFBProps->maxTransformFeedbackBufferSize = 0;
+	pXFBProps->maxTransformFeedbackStreamDataSize = 0;
+	pXFBProps->maxTransformFeedbackBufferDataSize = 0;
