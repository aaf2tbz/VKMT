-	// Metal has no native transform feedback. Advertise the spec minimum limits, with
-	// queries supported (emulated). Stream output capture itself is passthrough for now.
-	pXFBProps->maxTransformFeedbackBuffers = kMVKMaxTransformFeedbackBufferCount;
-	pXFBProps->maxTransformFeedbackBufferSize = 1 << 27;
-	pXFBProps->maxTransformFeedbackStreamDataSize = 512;
