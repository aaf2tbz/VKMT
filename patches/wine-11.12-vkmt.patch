+    /* VKMT: PE TEB in x28 on Darwin (kernel scrubs x18); built with -ffixed-x28 */
+    return (struct _TEB *)__getReg(28);
 }
 #elif defined(__x86_64__) && defined(__GNUC__)
 static FORCEINLINE struct _TEB * WINAPI NtCurrentTeb(void)
