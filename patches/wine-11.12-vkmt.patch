+        else
+        {
+            LONGLONG full = (opsize == 4) ? (LONGLONG)(INT)a * (INT)b : (LONGLONG)(SHORT)a * (SHORT)b;
+            set_reg( ctx, insn->reg, opsize, insn->rex != 0, (ULONGLONG)full );
+            ctx->eflags &= ~(FL_CF | FL_OF);
+            if (opsize == 4 ? full != (INT)full : full != (SHORT)full) ctx->eflags |= FL_CF | FL_OF;
+        }
+        break;
+    }
+    case 0xb0: case 0xb1:  /* cmpxchg */
+    {
+        UINT size = (op == 0xb0) ? 1 : opsize;
+        ULONGLONG acc = get_reg( ctx, VKMT_RAX, size, TRUE );
+        ULONGLONG src = get_reg( ctx, insn->reg, size, insn->rex != 0 );
+        if (insn->rm_is_reg)
+        {
+            ULONGLONG dst = get_reg( ctx, insn->rm, size, insn->rex != 0 );
+            alu_op( ctx, 5, acc, dst, size, FALSE );
+            if (ctx->eflags & FL_ZF) set_reg( ctx, insn->rm, size, insn->rex != 0, src );
+            else set_reg( ctx, VKMT_RAX, size, TRUE, dst );
+        }
+        else
+        {
+            ULONGLONG expect = acc;
+            BOOL ok;
+            if (size == 8)
+                ok = __atomic_compare_exchange_n( (ULONGLONG *)(ULONG_PTR)insn->ea, &expect, src,
+                                                  FALSE, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+            else if (size == 4)
+            {
+                UINT e = (UINT)expect;
+                ok = __atomic_compare_exchange_n( (UINT *)(ULONG_PTR)insn->ea, &e, (UINT)src,
+                                                  FALSE, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+                expect = e;
+            }
+            else if (size == 2)
+            {
+                USHORT e = (USHORT)expect;
+                ok = __atomic_compare_exchange_n( (USHORT *)(ULONG_PTR)insn->ea, &e, (USHORT)src,
+                                                  FALSE, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+                expect = e;
+            }
+            else
+            {
+                BYTE e = (BYTE)expect;
+                ok = __atomic_compare_exchange_n( (BYTE *)(ULONG_PTR)insn->ea, &e, (BYTE)src,
+                                                  FALSE, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+                expect = e;
+            }
+            alu_op( ctx, 5, acc, expect, size, FALSE );
+            if (!ok) set_reg( ctx, VKMT_RAX, size, TRUE, expect );
+        }
+        break;
+    }
+    case 0xb6: case 0xb7:  /* movzx */
+        set_reg( ctx, insn->reg, opsize == 2 ? 2 : (insn->rex & 8 ? 8 : 4), insn->rex != 0,
+                 get_rm( ctx, insn, op == 0xb6 ? 1 : 2 ) );
+        break;
+    case 0xb8:  /* popcnt (F3) / jmpe */
+        if (!(insn->pref & P_F3)) { giveup_dump( ctx, insn->opcode, "jmpe" ); return FALSE; }
+        set_reg( ctx, insn->reg, opsize, insn->rex != 0,
+                 (ULONGLONG)__builtin_popcountll( get_rm( ctx, insn, opsize ) & sz_mask( opsize ) ) );
+        ctx->eflags &= ~(FL_CF|FL_OF|FL_SF|FL_PF|FL_AF);
+        if (!(get_rm( ctx, insn, opsize ) & sz_mask( opsize ))) ctx->eflags |= FL_ZF;
+        else ctx->eflags &= ~FL_ZF;
+        break;
+    case 0xbc: case 0xbd:  /* bsf/bsr (tzcnt/lzcnt with F3 treated as bsf/bsr) */
+    {
+        ULONGLONG v = get_rm( ctx, insn, opsize ) & sz_mask( opsize );
+        if (!v)
+        {
+            ctx->eflags |= FL_ZF;
+        }
+        else
+        {
+            UINT i;
+            ctx->eflags &= ~FL_ZF;
+            if (op == 0xbc)
+            {
+                for (i = 0; i < opsize * 8; i++) if ((v >> i) & 1) break;
+            }
+            else
+            {
+                for (i = opsize * 8 - 1; i > 0; i--) if ((v >> i) & 1) break;
+            }
+            set_reg( ctx, insn->reg, opsize, insn->rex != 0, i );
+        }
+        break;
+    }
+    case 0xbe: case 0xbf:  /* movsx */
+    {
+        ULONGLONG v = get_rm( ctx, insn, op == 0xbe ? 1 : 2 );
+        if (op == 0xbe) v = (ULONGLONG)(LONGLONG)(signed char)v;
+        else v = (ULONGLONG)(LONGLONG)(SHORT)v;
+        set_reg( ctx, insn->reg, opsize == 2 ? 2 : (insn->rex & 8 ? 8 : 4), insn->rex != 0, v );
+        break;
+    }
+    case 0xc0: case 0xc1:  /* xadd */
+    {
+        UINT size = (op == 0xc0) ? 1 : opsize;
+        ULONGLONG src = get_reg( ctx, insn->reg, size, insn->rex != 0 );
+        if (insn->rm_is_reg)
+        {
+            ULONGLONG dst = get_reg( ctx, insn->rm, size, insn->rex != 0 );
+            set_reg( ctx, insn->reg, size, insn->rex != 0, dst );
+            set_reg( ctx, insn->rm, size, insn->rex != 0,
+                     alu_op( ctx, 0, dst, src, size, FALSE ) );
+        }
+        else
+        {
+            ULONGLONG old;
+            if (size == 8) old = __atomic_fetch_add( (ULONGLONG *)(ULONG_PTR)insn->ea, src, __ATOMIC_SEQ_CST );
+            else if (size == 4) old = __atomic_fetch_add( (UINT *)(ULONG_PTR)insn->ea, (UINT)src, __ATOMIC_SEQ_CST );
+            else if (size == 2) old = __atomic_fetch_add( (USHORT *)(ULONG_PTR)insn->ea, (USHORT)src, __ATOMIC_SEQ_CST );
+            else old = __atomic_fetch_add( (BYTE *)(ULONG_PTR)insn->ea, (BYTE)src, __ATOMIC_SEQ_CST );
+            alu_op( ctx, 0, old, src, size, FALSE );
+            set_reg( ctx, insn->reg, size, insn->rex != 0, old );
+        }
+        break;
+    }
+    case 0xc2:  /* cmpps/cmpss/cmpsd/cmppd */
+    {
+        BYTE dst[16], src[16];
+        UINT pred = (UINT)insn->imm & 7;
+        BOOL dbl = (insn->pref & P_66) || (insn->pref & P_F2);
+        BOOL scal = (insn->pref & (P_F2 | P_F3)) != 0;
+        UINT n = scal ? 1 : (dbl ? 2 : 4), i;
+        xmm_get( ctx, insn->reg, dst );
+        get_rm128( ctx, insn, src );
+        for (i = 0; i < n; i++)
+        {
+            BOOL res, unord = FALSE;
+            if (dbl)
+            {
+                double a, b;
+                memcpy( &a, dst + i * 8, 8 ); memcpy( &b, src + i * 8, 8 );
+                if (isnan(a) || isnan(b)) unord = TRUE;
+                switch (pred)
+                {
+                case 0: res = !unord && a == b; break;
+                case 1: res = !unord && a < b; break;
+                case 2: res = !unord && a <= b; break;
+                case 3: res = unord; break;
+                case 4: res = unord || a != b; break;
+                case 5: res = unord || a >= b; break;
+                case 6: res = unord || a > b; break;
+                default: res = !unord; break;
+                }
+                memset( dst + i * 8, res ? 0xff : 0, 8 );
+            }
+            else
+            {
+                float a, b;
+                memcpy( &a, dst + i * 4, 4 ); memcpy( &b, src + i * 4, 4 );
+                if (isnan(a) || isnan(b)) unord = TRUE;
+                switch (pred)
+                {
+                case 0: res = !unord && a == b; break;
+                case 1: res = !unord && a < b; break;
+                case 2: res = !unord && a <= b; break;
+                case 3: res = unord; break;
+                case 4: res = unord || a != b; break;
+                case 5: res = unord || a >= b; break;
+                case 6: res = unord || a > b; break;
+                default: res = !unord; break;
+                }
+                memset( dst + i * 4, res ? 0xff : 0, 4 );
+            }
+        }
+        xmm_put( ctx, insn->reg, dst );
+        break;
+    }
+    case 0xc3:  /* movnti */
+        mem_write( insn->ea, get_reg( ctx, insn->reg, opsize, insn->rex != 0 ), opsize );
+        break;
+    case 0xc7:  /* cmpxchg8b/16b (group9 /1) */
+        if ((insn->reg & 7) == 1 && !insn->rm_is_reg)
+        {
+            ULONGLONG lo_d = ctx->gpr[VKMT_RAX], hi_d = ctx->gpr[VKMT_RDX];
+            ULONGLONG lo_s = ctx->gpr[VKMT_RBX], hi_s = ctx->gpr[VKMT_RCX];
+            if (insn->rex & 8)
+            {
+                unsigned __int128 expect = ((unsigned __int128)hi_d << 64) | lo_d;
+                unsigned __int128 want   = ((unsigned __int128)hi_s << 64) | lo_s;
+                BOOL ok = __atomic_compare_exchange_n( (unsigned __int128 *)(ULONG_PTR)insn->ea,
+                                                       &expect, want, FALSE,
+                                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+                if (!ok)
+                {
+                    ctx->gpr[VKMT_RAX] = (ULONGLONG)expect;
+                    ctx->gpr[VKMT_RDX] = (ULONGLONG)(expect >> 64);
+                }
+                ctx->eflags = ok ? (ctx->eflags | FL_ZF) : (ctx->eflags & ~FL_ZF);
+            }
+            else
+            {
+                ULONGLONG expect = ((ULONGLONG)(UINT)hi_d << 32) | (UINT)lo_d;
+                ULONGLONG want   = ((ULONGLONG)(UINT)hi_s << 32) | (UINT)lo_s;
+                BOOL ok = __atomic_compare_exchange_n( (ULONGLONG *)(ULONG_PTR)insn->ea,
+                                                       &expect, want, FALSE,
+                                                       __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST );
+                if (!ok)
+                {
+                    ctx->gpr[VKMT_RAX] = (UINT)expect;
+                    ctx->gpr[VKMT_RDX] = (UINT)(expect >> 32);
+                }
+                ctx->eflags = ok ? (ctx->eflags | FL_ZF) : (ctx->eflags & ~FL_ZF);
+            }
+            break;
+        }
+        giveup_dump( ctx, insn->opcode, "unsupported group9 (0f c7)" );
+        return FALSE;
+    case 0xc6:  /* shufps/shufpd */
+    {
+        BYTE dst[16], src[16], out[16];
+        UINT sel = (UINT)insn->imm;
+        xmm_get( ctx, insn->reg, dst );
+        get_rm128( ctx, insn, src );
+        if (insn->pref & P_66)
+        {
+            memcpy( out, dst + (sel & 1) * 8, 8 );
+            memcpy( out + 8, src + ((sel >> 1) & 1) * 8, 8 );
+        }
+        else
+        {
+            memcpy( out, dst + (sel & 3) * 4, 4 );
+            memcpy( out + 4, dst + ((sel >> 2) & 3) * 4, 4 );
+            memcpy( out + 8, src + ((sel >> 4) & 3) * 4, 4 );
+            memcpy( out + 12, src + ((sel >> 6) & 3) * 4, 4 );
+        }
+        xmm_put( ctx, insn->reg, out );
+        break;
+    }
+    case 0xd4:  /* paddq */
+    case 0xfc:  /* paddb */
+    case 0xfd:  /* paddw */
+    case 0xfe:  /* paddd */
+    case 0xf8:  /* psubb */
+    case 0xf9:  /* psubw */
+    case 0xfa:  /* psubd */
+    case 0xfb:  /* psubq */
+    {
+        BYTE dst[16], src[16];
+        UINT esz, i;
+        BOOL sub = op >= 0xf8 && op <= 0xfb;
+        if (op == 0xd4 || op == 0xfb) esz = 8;
+        else if ((op & 3) == 0) esz = 1;
+        else if ((op & 3) == 1) esz = 2;
+        else esz = 4;
+        xmm_get( ctx, insn->reg, dst );
+        get_rm128( ctx, insn, src );
+        for (i = 0; i < 16; i += esz)
+        {
+            ULONGLONG a = 0, b = 0;
+            memcpy( &a, dst + i, esz ); memcpy( &b, src + i, esz );
+            a = sub ? a - b : a + b;
+            memcpy( dst + i, &a, esz );
+        }
+        xmm_put( ctx, insn->reg, dst );
+        break;
+    }
+    case 0xd6:  /* movq xmm -> xmm/m64 (66) */
+    {
+        BYTE src[16];
+        xmm_get( ctx, insn->reg, src );
+        if (insn->rm_is_reg)
+        {
+            BYTE out[16];
+            memset( out, 0, 16 );
+            memcpy( out, src, 8 );
+            xmm_put( ctx, insn->rm, out );
+        }
+        else memcpy( (void *)(ULONG_PTR)insn->ea, src, 8 );
+        break;
+    }
+    case 0xdb:  /* pand */
+    case 0xdf:  /* pandn */
+    case 0xeb:  /* por */
+    case 0xef:  /* pxor */
+    {
+        BYTE dst[16], src[16];
+        UINT i;
+        xmm_get( ctx, insn->reg, dst );
+        get_rm128( ctx, insn, src );
+        for (i = 0; i < 16; i++)
+        {
+            if (op == 0xdb) dst[i] &= src[i];
+            else if (op == 0xdf) dst[i] = ~dst[i] & src[i];
+            else if (op == 0xeb) dst[i] |= src[i];
+            else dst[i] ^= src[i];
+        }
+        xmm_put( ctx, insn->reg, dst );
+        break;
+    }
+    default:
+        giveup_dump( ctx, insn->opcode, "unsupported 0F opcode" );
+        return FALSE;
+    }
+
+    ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+    return TRUE;
+}
+
+/*************************************************************************
+ * Dispatch between maps
+ */
+static BOOL vkmt_execute( struct vkmt_x64_context *ctx, const struct vkmt_insn *insn )
+{
+    if (insn->opcode & 0x100) return exec_0f( ctx, insn );
+    if (!exec_primary( ctx, insn ))
+    {
+        /* exec_primary already dumped for the cases it diagnoses itself */
+        if (insn->opcode != 0x8c && insn->opcode != 0x8e && insn->opcode != 0xcc &&
+            insn->opcode != 0xff && insn->opcode != 0xfe &&
+            insn->opcode != 0xd8 && insn->opcode != 0xd9 && insn->opcode != 0xda &&
+            insn->opcode != 0xdb && insn->opcode != 0xdc && insn->opcode != 0xdd &&
+            insn->opcode != 0xde && insn->opcode != 0xdf &&
+            insn->opcode != 0xf6 && insn->opcode != 0xf7)
+            giveup_dump( ctx, insn->opcode, "unsupported opcode" );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/*************************************************************************
+ * Main interpreter loop
+ */
+void vkmt_interp_run( struct vkmt_x64_context *ctx, struct vkmt_interp_outcome *out )
+{
+    static BOOL tables_ready;
+    ULONGLONG count = 0;
+    struct vkmt_insn insn;
+
+    if (!tables_ready)
+    {
+        vkmt_init_tables();
+        tables_ready = TRUE;
+    }
+
+    for (;;)
+    {
+        const BYTE *ip = (const BYTE *)(ULONG_PTR)ctx->rip;
+
+        if (!ip)
+        {
+            ERR( "guest rip is NULL\n" );
+            out->result = VKMT_INTERP_GIVEUP;
+            out->opcode = 0;
+            return;
+        }
+        /* the marker lives in our own (EC) module: check it before the
+         * generic EC-code test */
+        if (ip == (const BYTE *)RetToEntryThunk)
+        {
+            out->result = VKMT_INTERP_EXIT_RETURN;
+            out->target = ctx->rip;
+            TRACE( "exit via return marker after %I64u insns\n", count );
+            ctx->insn_total += count;
+            return;
+        }
+        if (RtlIsEcCode( (ULONG_PTR)ip ))
+        {
+            out->result = VKMT_INTERP_EXIT_NATIVE;
+            out->target = ctx->rip;
+            TRACE( "exit to native at %p after %I64u insns\n", (void *)ctx->rip, count );
+            ctx->insn_total += count;
+            return;
+        }
+        if (++count > VKMT_MAX_INSNS_PER_RUN)
+        {
+            giveup_dump( ctx, 0x1bad, "runaway guest (instruction budget exhausted)" );
+            out->result = VKMT_INTERP_GIVEUP;
+            out->opcode = 0x1bad;
+            ctx->insn_total += count;
+            return;
+        }
+
+        vkmt_decode( ctx, &insn );
+        ctx->exec_ring[ctx->exec_pos & 8191][0] = ctx->rip;
+        ctx->exec_ring[ctx->exec_pos & 8191][1] = ctx->eflags;
+        ctx->exec_ring[ctx->exec_pos & 8191][2] = ctx->gpr[VKMT_RAX];
+        ctx->exec_ring[ctx->exec_pos & 8191][3] = ctx->gpr[VKMT_RCX];
+        ctx->exec_pos++;
+        /* lea and hint-nops/prefetch compute but never dereference the operand */
+        if (insn.bad_ea && insn.opcode != 0x8d && insn.opcode != 0x10d &&
+            !(insn.opcode >= 0x118 && insn.opcode <= 0x11f))
+        {
+            giveup_dump( ctx, insn.opcode, "guest memory operand in the null page" );
+            ERR( "  offending effective address: %p\n", (void *)insn.ea );
+            out->result = VKMT_INTERP_GIVEUP;
+            out->opcode = insn.opcode;
+            ctx->insn_total += count;
+            return;
+        }
+        if (!vkmt_execute( ctx, &insn ))
+        {
+            out->result = VKMT_INTERP_GIVEUP;
+            out->opcode = insn.opcode;
+            ctx->insn_total += count;
+            return;
+        }
+    }
+}
