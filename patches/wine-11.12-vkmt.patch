+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "vkmt.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(vkmtx64);
+
+static inline CHPE_V2_CPU_AREA_INFO *vkmt_cpu_area(void)
+{
+    return NtCurrentTeb()->ChpeV2CpuAreaInfo;
+}
+
+/**********************************************************************
+ *           vkmt_context_from_ec
+ *
+ * Snapshot the live EC context into the emulator-private guest context.
+ */
+void vkmt_context_from_ec( struct vkmt_x64_context *ctx, const ARM64EC_NT_CONTEXT *ec )
+{
+    ctx->gpr[VKMT_RAX] = ec->X8;  ctx->gpr[VKMT_RCX] = ec->X0;
+    ctx->gpr[VKMT_RDX] = ec->X1;  ctx->gpr[VKMT_RBX] = ec->X27;
+    ctx->gpr[VKMT_RSP] = ec->Sp;  ctx->gpr[VKMT_RBP] = ec->Fp;
+    ctx->gpr[VKMT_RSI] = ec->X25; ctx->gpr[VKMT_RDI] = ec->X26;
+    ctx->gpr[VKMT_R8]  = ec->X2;  ctx->gpr[VKMT_R9]  = ec->X3;
+    ctx->gpr[VKMT_R10] = ec->X4;  ctx->gpr[VKMT_R11] = ec->X5;
+    ctx->gpr[VKMT_R12] = ec->X19; ctx->gpr[VKMT_R13] = ec->X20;
+    ctx->gpr[VKMT_R14] = ec->X21; ctx->gpr[VKMT_R15] = ec->X22;
+    ctx->rip    = ec->Pc;
+    ctx->eflags = ec->AMD64_EFlags;
+    ctx->mxcsr  = ec->AMD64_MxCsr;
+    ctx->fcw    = ec->AMD64_ControlWord;
+    memcpy( ctx->xmm, ec->V, sizeof(ctx->xmm) );
+}
+
+/**********************************************************************
+ *           vkmt_context_to_ec
+ */
+void vkmt_context_to_ec( ARM64EC_NT_CONTEXT *ec, const struct vkmt_x64_context *ctx )
+{
+    ec->X8  = ctx->gpr[VKMT_RAX]; ec->X0  = ctx->gpr[VKMT_RCX];
+    ec->X1  = ctx->gpr[VKMT_RDX]; ec->X27 = ctx->gpr[VKMT_RBX];
+    ec->Sp  = ctx->gpr[VKMT_RSP]; ec->Fp  = ctx->gpr[VKMT_RBP];
+    ec->X25 = ctx->gpr[VKMT_RSI]; ec->X26 = ctx->gpr[VKMT_RDI];
+    ec->X2  = ctx->gpr[VKMT_R8];  ec->X3  = ctx->gpr[VKMT_R9];
+    ec->X4  = ctx->gpr[VKMT_R10]; ec->X5  = ctx->gpr[VKMT_R11];
+    ec->X19 = ctx->gpr[VKMT_R12]; ec->X20 = ctx->gpr[VKMT_R13];
+    ec->X21 = ctx->gpr[VKMT_R14]; ec->X22 = ctx->gpr[VKMT_R15];
+    ec->Pc           = ctx->rip;
+    ec->AMD64_EFlags = ctx->eflags;
+    ec->AMD64_MxCsr  = ec->AMD64_MxCsr_copy = ctx->mxcsr;
+    ec->AMD64_ControlWord = ctx->fcw;
+    memcpy( ec->V, ctx->xmm, sizeof(ctx->xmm) );
+}
+
+/**********************************************************************
+ *           vkmt_thread_context
+ */
+struct vkmt_x64_context *vkmt_thread_context(void)
+{
+    CHPE_V2_CPU_AREA_INFO *cpu_area = vkmt_cpu_area();
+
+    if (!cpu_area) return NULL;
+    if (!cpu_area->EmulatorData[0])
+    {
+        struct vkmt_x64_context *ctx = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY,
+                                                        sizeof(struct vkmt_x64_context) );
+        if (ctx)
+        {
+            ctx->gsbase = (ULONGLONG)NtCurrentTeb();  /* x64 TLS/TEB access via gs: */
+            ctx->fcw    = 0x27f;
+            ctx->mxcsr  = 0x1f80;
+        }
+        cpu_area->EmulatorData[0] = ctx;
+    }
+    return cpu_area->EmulatorData[0];
+}
+
+/**********************************************************************
+ *           vkmt_process_init
+ */
+NTSTATUS vkmt_process_init(void)
+{
+    TRACE( "VKMT x86-64 emulator skeleton (M2): process init\n" );
+    return STATUS_SUCCESS;
+}
+
+/**********************************************************************
+ *           vkmt_process_term
+ */
+void vkmt_process_term( HANDLE handle, BOOL is_post, NTSTATUS status )
+{
+    TRACE( "process term handle %p is_post %d status %lx\n", handle, is_post, status );
+}
+
+/**********************************************************************
+ *           vkmt_thread_init
+ */
+NTSTATUS vkmt_thread_init(void)
+{
+    CHPE_V2_CPU_AREA_INFO *cpu_area = vkmt_cpu_area();
+
+    TRACE( "thread %04lx init, cpu area %p\n",
+                     GetCurrentThreadId(), cpu_area );
+    if (!cpu_area)
+    {
+        ERR( "thread %04lx has no CHPE cpu area\n", GetCurrentThreadId() );
+        return STATUS_UNSUCCESSFUL;
+    }
+    if (!vkmt_thread_context())
+    {
+        ERR( "failed to allocate guest context\n" );
+        return STATUS_NO_MEMORY;
+    }
+    return STATUS_SUCCESS;
+}
+
+/**********************************************************************
+ *           vkmt_thread_term
+ */
+void vkmt_thread_term( HANDLE handle, LONG exit_code )
+{
+    CHPE_V2_CPU_AREA_INFO *cpu_area = vkmt_cpu_area();
+
+    TRACE( "thread term handle %p exit_code %lx\n", handle, exit_code );
+    if (cpu_area && cpu_area->EmulatorData[0])
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, cpu_area->EmulatorData[0] );
+        cpu_area->EmulatorData[0] = NULL;
+    }
+}
+
+/**********************************************************************
+ *           vkmt_is_processor_feature_present
+ *
+ * Baseline for a modern x64 CPU, matching what Windows' xtajit reports
+ * (through SSE4.2; no AVX until the interpreter supports it).
+ */
+BOOLEAN vkmt_is_processor_feature_present( UINT feature )
+{
+    static const ULONGLONG x86_features =
+        (1ull << PF_COMPARE_EXCHANGE_DOUBLE) |
+        (1ull << PF_MMX_INSTRUCTIONS_AVAILABLE) |
+        (1ull << PF_XMMI_INSTRUCTIONS_AVAILABLE) |
+        (1ull << PF_RDTSC_INSTRUCTION_AVAILABLE) |
+        (1ull << PF_XMMI64_INSTRUCTIONS_AVAILABLE) |
+        (1ull << PF_NX_ENABLED) |
+        (1ull << PF_SSE3_INSTRUCTIONS_AVAILABLE) |
+        (1ull << PF_COMPARE_EXCHANGE128) |
+        (1ull << PF_FASTFAIL_AVAILABLE) |
+        (1ull << PF_RDTSCP_INSTRUCTION_AVAILABLE) |
+        (1ull << PF_SSSE3_INSTRUCTIONS_AVAILABLE) |
+        (1ull << PF_SSE4_1_INSTRUCTIONS_AVAILABLE) |
+        (1ull << PF_SSE4_2_INSTRUCTIONS_AVAILABLE);
+
+    return feature < 64 && (x86_features & (1ull << feature));
+}
+
+/**********************************************************************
+ *           vkmt_update_processor_information
+ */
+void vkmt_update_processor_information( SYSTEM_CPU_INFORMATION *info )
+{
+    /* cf. the x86_64 unix side: AMD64 architecture, family/model in
+     * level/revision, no feature bits */
+    info->ProcessorArchitecture = PROCESSOR_ARCHITECTURE_AMD64;
+    info->ProcessorLevel        = 21;   /* Zen 2 family */
+    info->ProcessorRevision     = 1;
+    info->ProcessorFeatureBits  = 0;
+}
diff -ruN --exclude=*.o --exclude=.git /tmp/wine-11.12/dlls/xtajit64/vkmt/dispatch.c wine/wine-11.12/dlls/xtajit64/vkmt/dispatch.c
--- /tmp/wine-11.12/dlls/xtajit64/vkmt/dispatch.c	1969-12-31 17:00:00
+++ wine/wine-11.12/dlls/xtajit64/vkmt/dispatch.c	2026-07-25 16:03:37
@@ -0,0 +1,336 @@
+/*
+ * VKMT x86-64 emulator skeleton — simulation entry/exit and dispatch
+ *
+ * Copyright 2026 Avery Felts
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * ABI conventions (derived from ntdll/signal_arm64ec.c and llvm-mingw
+ * thunk disassembly; see docs/EMULATION.md, M2 section):
+ *
+ *  - BeginSimulation: plain EC call; guest state already converted into
+ *    cpu_area->ContextAmd64 by ntdll; InSimulation already 1. Never returns.
+ *  - ExitToX64 / DispatchJump: entered via blr/br from exit thunks with
+ *    x9 = x64 target, x0-x7 = args, sp = guest stack, lr = native return
+ *    address. Guest RAX is handed back to native code in x8.
+ *  - RetToEntryThunk: entered via br from entry thunks when a native call
+ *    from the emulator returns; x8 = guest RAX, [sp] = x64 return address.
+ */
+
+#include <stdarg.h>
+
+#include "vkmt.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(vkmtx64);
+
+extern void RetToEntryThunk(void);
+
+static inline CHPE_V2_CPU_AREA_INFO *vkmt_cpu_area(void)
+{
+    return NtCurrentTeb()->ChpeV2CpuAreaInfo;
+}
+
+static UINT cpsr_to_eflags( UINT cpsr )  /* cf. ntdll/unwind.h */
+{
+    UINT ret = 0x202;
+
+    if (cpsr & 0x00200000) ret |= 0x0100;  /* trap */
+    if (cpsr & 0x10000000) ret |= 0x0800;  /* overflow */
+    if (cpsr & 0x20000000) ret |= 0x0001;  /* carry */
+    if (cpsr & 0x40000000) ret |= 0x0040;  /* zero */
+    if (cpsr & 0x80000000) ret |= 0x0080;  /* negative */
+    return ret;
+}
+
+/**********************************************************************
+ *           vkmt_simulate
+ *
+ * Common simulation loop: run the interpreter skeleton on the per-thread
+ * guest context, then leave via NtContinue (native target) or terminate
+ * cleanly with a loud diagnostic.  Called on the emulator stack.
+ */
+static void vkmt_simulate( CHPE_V2_CPU_AREA_INFO *cpu_area )
+{
+    ARM64EC_NT_CONTEXT *ec = cpu_area->ContextAmd64;
+    struct vkmt_x64_context *ctx = vkmt_thread_context();
+    struct vkmt_interp_outcome out;
+    NTSTATUS status;
+
+    if (!ctx)
+    {
+        ERR( "no per-thread guest context, cannot simulate\n" );
+        NtTerminateProcess( GetCurrentProcess(), STATUS_NO_MEMORY );
+    }
+
+    cpu_area->InSimulation = 1;
+    vkmt_context_from_ec( ctx, ec );
+
+    TRACE( "enter simulation: thread %04lx guest rip %p rsp %p\n",
+           GetCurrentThreadId(), (void *)ctx->rip, (void *)ctx->gpr[VKMT_RSP] );
+
+    vkmt_interp_run( ctx, &out );
+
+    vkmt_context_to_ec( ec, ctx );
+
+    switch (out.result)
+    {
+    case VKMT_INTERP_EXIT_NATIVE:
+        ec->Pc = out.target;
+        /* the EC callee returns with a plain `ret` (x30): point LR at the
+         * RetToEntryThunk marker so the return pops the guest return address
+         * off the guest stack and re-enters simulation */
+        ec->Lr = (ULONG64)RetToEntryThunk;
+        cpu_area->InSimulation = 0;
+        TRACE( "exit simulation to native pc %p (rax %p rsp %p)\n",
+               (void *)out.target, (void *)ec->X8, (void *)ec->Sp );
+        if (!(status = NtContinue( (CONTEXT *)ec, FALSE ))) break;
+        ERR( "NtContinue failed: %lx\n", status );
+        break;
+
+    case VKMT_INTERP_EXIT_RETURN:
+        /* guest executed `ret` into the RetToEntryThunk marker: hand control
+         * back to the EC caller at the native return address captured on
+         * entry; guest RAX is already in X8 where the thunk expects it, and
+         * the thunk epilogue needs its own entry SP/FP back (the guest's
+         * stack usage is discarded with the call frame). */
+        ec->Pc = ctx->native_ret ? ctx->native_ret : ec->Lr;
+        ec->Sp = (ULONG64)cpu_area->EmulatorData[2];
+        ec->Fp = (ULONG64)cpu_area->EmulatorData[3];
+        cpu_area->InSimulation = 0;
+        TRACE( "guest returned to EC caller at %p (rax %p)\n",
+               (void *)ec->Pc, (void *)ec->X8 );
+        if (!(status = NtContinue( (CONTEXT *)ec, FALSE ))) break;
+        ERR( "NtContinue failed: %lx\n", status );
+        break;
+
+    default:
+        ERR( "VKMT interpreter: cannot continue guest execution at rip %p "
+             "(opcode %02lx) — terminating process cleanly\n",
+             (void *)ctx->rip, out.opcode );
+        NtTerminateProcess( GetCurrentProcess(), STATUS_ILLEGAL_INSTRUCTION );
+    }
+    NtTerminateProcess( GetCurrentProcess(), STATUS_UNSUCCESSFUL );
+}
+
+/**********************************************************************
+ *           vkmt_begin_simulation  (C body of BeginSimulation)
+ */
+void vkmt_begin_simulation(void)
+{
+    CHPE_V2_CPU_AREA_INFO *cpu_area = vkmt_cpu_area();
+    ARM64EC_NT_CONTEXT *ec = cpu_area->ContextAmd64;
+
+    TRACE( "BeginSimulation: thread %04lx guest rip %p rsp %p\n",
+           GetCurrentThreadId(), (void *)ec->Pc, (void *)ec->Sp );
+    vkmt_simulate( cpu_area );
+}
+
+/**********************************************************************
+ *           vkmt_simulate_from_ec  (C body of ExitToX64/DispatchJump/RetToEntryThunk)
+ *
+ * plant_marker: ExitToX64/DispatchJump plant the RetToEntryThunk marker
+ * on top of the guest stack, so a guest `ret` pops it and takes the
+ * EXIT_RETURN path back to the native caller.
+ */
+void vkmt_simulate_from_ec( int plant_marker )
+{
+    CHPE_V2_CPU_AREA_INFO *cpu_area = vkmt_cpu_area();
+    ARM64EC_NT_CONTEXT *ec = cpu_area->ContextAmd64;
+
+    /* the asm entry captured raw NZCV into EmulatorData[1] */
+    ec->AMD64_EFlags = cpsr_to_eflags( (UINT)(ULONG_PTR)cpu_area->EmulatorData[1] );
+    cpu_area->EmulatorData[1] = 0;
+
+    /* mirror context_arm_to_x64() fixups that ntdll would normally do */
+    ec->ContextFlags   = CONTEXT_AMD64_ALL;
+    ec->AMD64_SegCs    = 0x33;
+    ec->AMD64_SegDs    = 0x2b;
+    ec->AMD64_SegEs    = 0x2b;
+    ec->AMD64_SegFs    = 0x53;
+    ec->AMD64_SegGs    = 0x2b;
+    ec->AMD64_SegSs    = 0x2b;
+    if (!ec->AMD64_MxCsr) ec->AMD64_MxCsr = ec->AMD64_MxCsr_copy = 0x1f80;
+
+    if (plant_marker)
+    {
+        struct vkmt_x64_context *ctx = vkmt_thread_context();
+
+        *(ULONGLONG *)(ULONG_PTR)ec->Sp = (ULONGLONG)RetToEntryThunk;
+        /* save the thunk-entry frame: on EXIT_RETURN the guest's `ret` has
+         * popped the marker, but the exit thunk epilogue must resume with
+         * the exact SP/FP it had when it called us */
+        cpu_area->EmulatorData[2] = (void *)(ULONG_PTR)ec->Sp;
+        cpu_area->EmulatorData[3] = (void *)(ULONG_PTR)ec->Fp;
+        if (ctx) ctx->native_ret = ec->Lr;
+    }
+
+    TRACE( "simulation from EC: thread %04lx guest rip %p rsp %p native lr %p\n",
+           GetCurrentThreadId(), (void *)ec->Pc, (void *)ec->Sp, (void *)ec->Lr );
+    vkmt_simulate( cpu_area );
+}
+
+/*
+ * Register capture for the thunk-entered paths.  Stores the guest-visible
+ * ARM64EC registers into cpu_area->ContextAmd64 (see include/winnt.h
+ * ARM64EC_NT_CONTEXT for the x64<->arm64 aliasing), raw NZCV into
+ * EmulatorData[1], sets InSimulation, switches to the emulator stack and
+ * calls the C body.  Clobbers x9/x16/x17 only.
+ *
+ * The caller places the guest rip in x9 before the capture (already true
+ * for ExitToX64/DispatchJump; RetToEntryThunk pops it first).
+ */
+#define VKMT_CAPTURE_AND_SIMULATE(first_insn, plant_marker) \
+    asm( first_insn \
+         "ldr x16, [x28, %[teb]]\n\t"           /* cpu area */ \
+         "ldr x17, [x16, %[area_ctx]]\n\t"      /* ContextAmd64 */ \
+         "str x9,  [x17, %[ctx_pc]]\n\t"        /* guest rip */ \
+         "mov w9, #1\n\t" \
+         "strb w9, [x16, %[area_insim]]\n\t"    /* InSimulation = 1 */ \
+         "stp x0,  x1,  [x17, %[ctx_x0]]\n\t" \
+         "stp x2,  x3,  [x17, %[ctx_x2]]\n\t" \
+         "stp x4,  x5,  [x17, %[ctx_x4]]\n\t" \
+         "stp x6,  x7,  [x17, %[ctx_x6]]\n\t" \
+         "str x8,       [x17, %[ctx_x8]]\n\t" \
+         "stp x10, x11, [x17, %[ctx_x10]]\n\t" \
+         "str x12,      [x17, %[ctx_x12]]\n\t" \
+         "str x15,      [x17, %[ctx_x15]]\n\t" \
+         "stp x19, x20, [x17, %[ctx_x19]]\n\t" \
+         "stp x21, x22, [x17, %[ctx_x21]]\n\t" \
+         "stp x25, x26, [x17, %[ctx_x25]]\n\t" \
+         "str x27,      [x17, %[ctx_x27]]\n\t" \
+         "mov x9, sp\n\t" \
+         "stp x9,  x29, [x17, %[ctx_sp]]\n\t"   /* Sp, Fp (adjacent) */ \
+         "str x30,      [x17, %[ctx_lr]]\n\t"   /* native return address */ \
+         "mrs x9, nzcv\n\t" \
+         "str x9, [x16, %[area_nzcv]]\n\t"      /* raw cpsr scratch */ \
+         "add x9, x17, %[ctx_v]\n\t"            /* guest xmm0-15 = v0-v15 */ \
+         "stp q0,  q1,  [x9], #32\n\t" \
+         "stp q2,  q3,  [x9], #32\n\t" \
+         "stp q4,  q5,  [x9], #32\n\t" \
+         "stp q6,  q7,  [x9], #32\n\t" \
+         "stp q8,  q9,  [x9], #32\n\t" \
+         "stp q10, q11, [x9], #32\n\t" \
+         "stp q12, q13, [x9], #32\n\t" \
+         "stp q14, q15, [x9]\n\t" \
+         "ldr x9, [x16, %[area_stk]]\n\t"       /* EmulatorStackBase */ \
+         "and x9, x9, #0xfffffffffffffff0\n\t" \
+         "mov sp, x9\n\t" \
+         "mov w0, #" #plant_marker "\n\t" \
+         "bl vkmt_simulate_from_ec\n\t" \
+         "brk #1\n\t" \
+         :: [teb]        "i" (offsetof( TEB, ChpeV2CpuAreaInfo )), \
+            [area_ctx]   "i" (offsetof( CHPE_V2_CPU_AREA_INFO, ContextAmd64 )), \
+            [area_insim] "i" (offsetof( CHPE_V2_CPU_AREA_INFO, InSimulation )), \
+            [area_stk]   "i" (offsetof( CHPE_V2_CPU_AREA_INFO, EmulatorStackBase )), \
+            [area_nzcv]  "i" (offsetof( CHPE_V2_CPU_AREA_INFO, EmulatorData[1] )), \
+            [ctx_pc]     "i" (offsetof( ARM64EC_NT_CONTEXT, Pc )), \
+            [ctx_x0]     "i" (offsetof( ARM64EC_NT_CONTEXT, X0 )), \
+            [ctx_x2]     "i" (offsetof( ARM64EC_NT_CONTEXT, X2 )), \
+            [ctx_x4]     "i" (offsetof( ARM64EC_NT_CONTEXT, X4 )), \
+            [ctx_x6]     "i" (offsetof( ARM64EC_NT_CONTEXT, X6 )), \
+            [ctx_x8]     "i" (offsetof( ARM64EC_NT_CONTEXT, X8 )), \
+            [ctx_x10]    "i" (offsetof( ARM64EC_NT_CONTEXT, X10 )), \
+            [ctx_x12]    "i" (offsetof( ARM64EC_NT_CONTEXT, X12 )), \
+            [ctx_x15]    "i" (offsetof( ARM64EC_NT_CONTEXT, X15 )), \
+            [ctx_x19]    "i" (offsetof( ARM64EC_NT_CONTEXT, X19 )), \
+            [ctx_x21]    "i" (offsetof( ARM64EC_NT_CONTEXT, X21 )), \
+            [ctx_x25]    "i" (offsetof( ARM64EC_NT_CONTEXT, X25 )), \
+            [ctx_x27]    "i" (offsetof( ARM64EC_NT_CONTEXT, X27 )), \
+            [ctx_sp]     "i" (offsetof( ARM64EC_NT_CONTEXT, Sp )), \
+            [ctx_lr]     "i" (offsetof( ARM64EC_NT_CONTEXT, Lr )), \
+            [ctx_v]      "i" (offsetof( ARM64EC_NT_CONTEXT, V )) )
+
+/**********************************************************************
+ *           ExitToX64  (xtajit64.@)
+ *
+ * Implementation of __os_arm64x_dispatch_call_no_redirect.
+ * Entered from exit thunks with x9 = x64 target.
+ */
+void __attribute__((naked)) ExitToX64(void)
+{
+    VKMT_CAPTURE_AND_SIMULATE( "", 1 );
+}
+
+/**********************************************************************
+ *           DispatchJump  (xtajit64.@)
+ *
+ * Implementation of __os_arm64x_dispatch_fptr.
+ * Tail jump into x64 code; same convention as ExitToX64.
+ */
+void __attribute__((naked)) DispatchJump(void)
+{
+    VKMT_CAPTURE_AND_SIMULATE( "", 1 );
+}
+
+/**********************************************************************
+ *           RetToEntryThunk  (xtajit64.@)
+ *
+ * Implementation of __os_arm64x_dispatch_ret.
+ * Entered from entry thunk epilogues with x8 = guest rax and the x64
+ * return address on top of the guest stack.
+ */
+void __attribute__((naked)) RetToEntryThunk(void)
+{
+    VKMT_CAPTURE_AND_SIMULATE( "mov x8, x0\n\t"          /* EC result -> guest rax (no-op via real ientry thunks) */
+                               "ldr x9, [sp], #8\n\t"    /* guest rip = x64 return address */, 0 );
+}
+
+/**********************************************************************
+ *           BeginSimulation  (xtajit64.@)
+ *
+ * Called by ntdll's emulation dispatcher with the guest state already in
+ * ContextAmd64 and InSimulation = 1.  Switch to the emulator stack and
+ * run the simulation loop.  Never returns.
+ */
+void __attribute__((naked)) BeginSimulation(void)
+{
+    asm( "ldr x16, [x28, %[teb]]\n\t"
+         "ldr x9, [x16, %[area_stk]]\n\t"
+         "and x9, x9, #0xfffffffffffffff0\n\t"
+         "mov sp, x9\n\t"
+         "bl vkmt_begin_simulation\n\t"
+         "brk #1\n\t"
+         :: [teb]      "i" (offsetof( TEB, ChpeV2CpuAreaInfo )),
+            [area_stk] "i" (offsetof( CHPE_V2_CPU_AREA_INFO, EmulatorStackBase )) );
+}
+
+/**********************************************************************
+ *           vkmt_reset_to_consistent_state
+ *
+ * Called by ntdll's exception path with the guest context before
+ * dispatching to x64/EC handlers.  M2: nothing to reconcile yet.
+ */
+void vkmt_reset_to_consistent_state( EXCEPTION_RECORD *rec, CONTEXT *context, ARM64_NT_CONTEXT *arm_ctx )
+{
+    ARM64EC_NT_CONTEXT *ec = (ARM64EC_NT_CONTEXT *)context;
+    CHPE_V2_CPU_AREA_INFO *cpu_area = vkmt_cpu_area();
+
+    TRACE( "rec %p (code %lx) context %p arm_ctx %p\n",
+           rec, rec ? rec->ExceptionCode : 0, context, arm_ctx );
+    if (rec)
+    {
+        ERR( "exception %lx at pc %p: addr %p info %Ix %Ix; guest rip %p rsp %p rax %p\n",
+             rec->ExceptionCode, rec->ExceptionAddress,
+             (void *)(rec->NumberParameters > 1 ? rec->ExceptionInformation[1] : 0),
+             rec->NumberParameters > 0 ? rec->ExceptionInformation[0] : 0,
+             rec->NumberParameters > 1 ? rec->ExceptionInformation[1] : 0,
+             (void *)ec->Pc, (void *)ec->Sp, (void *)ec->X8 );
+        /* if the fault happened inside the interpreter, the live guest
+         * context still points at the faulting instruction */
+        if (cpu_area && cpu_area->InSimulation && cpu_area->EmulatorData[0])
+            vkmt_dump_guest( cpu_area->EmulatorData[0], 0xbad,
+                             "host fault during simulation (guest AV inside the interpreter?)" );
+    }
+}
diff -ruN --exclude=*.o --exclude=.git /tmp/wine-11.12/dlls/xtajit64/vkmt/interp.c wine/wine-11.12/dlls/xtajit64/vkmt/interp.c
--- /tmp/wine-11.12/dlls/xtajit64/vkmt/interp.c	1969-12-31 17:00:00
+++ wine/wine-11.12/dlls/xtajit64/vkmt/interp.c	2026-07-25 16:00:04
@@ -0,0 +1,2417 @@
+/*
+ * VKMT x86-64 emulator — interpreter core (M3)
+ *
+ * Copyright 2026 Avery Felts
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Structure: a full decode stage (vkmt_decode) fills a vkmt_insn with
+ * prefix/opcode/ModRM/SIB/displacement/immediate metadata and resolves the
+ * rm operand to either a register index or an effective address; a separate
+ * execute stage (vkmt_execute) performs the operation.  The metadata is
+ * exactly what a future JIT backend would consume.
+ *
+ * RFLAGS model: always-compute.  Every ALU instruction materialises
+ * CF/OF/AF/SF/ZF/PF into ctx->eflags immediately (no lazy flag state).
+ *
+ * Unknown opcode / int3 / syscall: dump guest context (registers, 32 bytes
+ * at rip, last 16 branch targets) and give up — the dispatcher then
+ * terminates the process with STATUS_ILLEGAL_INSTRUCTION.
+ */
+
+#include <stdarg.h>
+#include <math.h>
+
+#include "vkmt.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(vkmtx64);
+
+extern void RetToEntryThunk(void);
+
+#define VKMT_MAX_INSNS_PER_RUN 500000000ull   /* runaway-guest guard */
+
+/* eflags bits */
+#define FL_CF 0x0001
+#define FL_PF 0x0004
+#define FL_AF 0x0010
+#define FL_ZF 0x0040
+#define FL_SF 0x0080
+#define FL_IF 0x0200
+#define FL_DF 0x0400
+#define FL_OF 0x0800
+
+/* prefix bits in vkmt_insn.pref */
+#define P_66   0x01
+#define P_F2   0x02
+#define P_F3   0x04
+#define P_LOCK 0x08
+#define P_FS   0x10
+#define P_GS   0x20
+
+struct vkmt_insn
+{
+    const BYTE *start;     /* first byte of the instruction */
+    UINT   len;            /* total length in bytes */
+    UINT   opcode;         /* 0x000-0x0ff primary map, 0x100-0x1ff for 0F map */
+    UINT   rex;            /* REX byte, 0 when absent */
+    UINT   pref;           /* P_* bits */
+    BOOL   has_modrm;
+    UINT   reg;            /* modrm.reg, REX.R-extended (0-15) */
+    UINT   rm;             /* modrm.rm, REX.B-extended, when rm_is_reg */
+    BOOL   rm_is_reg;
+    ULONGLONG ea;          /* effective address, when !rm_is_reg */
+    ULONGLONG imm;
+    UINT   imm_size;       /* bytes */
+    BOOL   bad_ea;         /* resolved memory operand in the null page (< 0x10000) */
+};
+
+/*************************************************************************
+ * Decode tables: which opcodes carry a ModRM byte and an immediate.
+ */
+static BYTE tab_modrm[0x200];
+static BYTE tab_imm[0x200];   /* 0 none, 1 imm8, 2 immz, 3 immv, 4 imm16, 5 moffs64, 6 imm16+imm8 */
+
+static void vkmt_init_tables(void)
+{
+    static const BYTE primary_modrm[] =
+    {
+        0x00,0x01,0x02,0x03, 0x08,0x09,0x0a,0x0b, 0x10,0x11,0x12,0x13,
+        0x18,0x19,0x1a,0x1b, 0x20,0x21,0x22,0x23, 0x28,0x29,0x2a,0x2b,
+        0x30,0x31,0x32,0x33, 0x38,0x39,0x3a,0x3b, 0x62,0x63, 0x69,0x6b,
+        0x80,0x81,0x82,0x83,0x84,0x85,0x86,0x87,0x88,0x89,0x8a,0x8b,0x8c,0x8d,0x8e,0x8f,
+        0xc0,0xc1,0xc6,0xc7, 0xd0,0xd1,0xd2,0xd3, 0xd8,0xd9,0xda,0xdb,0xdc,0xdd,0xde,0xdf,
+        0xf6,0xf7, 0xfe,0xff
+    };
+    static const BYTE primary_imm8[] =
+    {
+        0x6a,0x6b, 0x70,0x71,0x72,0x73,0x74,0x75,0x76,0x77,0x78,0x79,0x7a,0x7b,0x7c,0x7d,0x7e,0x7f,
+        0x80,0x82,0x83, 0xa8, 0xb0,0xb1,0xb2,0xb3,0xb4,0xb5,0xb6,0xb7, 0xc0,0xc1,0xc6, 0xcd,
+        0xe0,0xe1,0xe2,0xe3, 0xeb
+    };
+    static const BYTE primary_immz[] = { 0x05,0x0d,0x15,0x1d,0x25,0x2d,0x35,0x3d,
+                                         0x68,0x69,0x81,0xa9,0xc7,0xe8,0xe9 };
+    static const BYTE primary_immv[] = { 0xb8,0xb9,0xba,0xbb,0xbc,0xbd,0xbe,0xbf };
+    static const BYTE primary_imm16[] = { 0xc2 };
+    static const BYTE primary_moffs[] = { 0xa0,0xa1,0xa2,0xa3 };
+    UINT i;
+
+    for (i = 0; i < ARRAY_SIZE(primary_modrm); i++) tab_modrm[primary_modrm[i]] = 1;
+    for (i = 0; i < ARRAY_SIZE(primary_imm8);  i++) tab_imm[primary_imm8[i]]  = 1;
+    for (i = 0; i < ARRAY_SIZE(primary_immz);  i++) tab_imm[primary_immz[i]]  = 2;
+    for (i = 0; i < ARRAY_SIZE(primary_immv);  i++) tab_imm[primary_immv[i]]  = 3;
+    for (i = 0; i < ARRAY_SIZE(primary_imm16); i++) tab_imm[primary_imm16[i]] = 4;
+    for (i = 0; i < ARRAY_SIZE(primary_moffs); i++) tab_imm[primary_moffs[i]] = 5;
+    tab_imm[0xc8] = 6;  /* enter imm16,imm8 */
+    tab_imm[0xf6] = 1;  /* group3 /0 test r/m8,imm8 */
+    tab_imm[0xf7] = 2;  /* group3 /0 test r/mz,immz */
+
+    /* 0F map */
+    for (i = 0x00; i <= 0x03; i++) tab_modrm[0x100|i] = 1;
+    tab_modrm[0x101] = 1; /* xgetbv/rdtscp/monitor... */
+    tab_modrm[0x10d] = 1; /* prefetch */
+    for (i = 0x10; i <= 0x17; i++) tab_modrm[0x100|i] = 1;
+    for (i = 0x18; i <= 0x1f; i++) tab_modrm[0x100|i] = 1;  /* hint nops / endbr */
+    tab_modrm[0x128] = tab_modrm[0x129] = 1;
+    for (i = 0x2a; i <= 0x2f; i++) tab_modrm[0x100|i] = 1;
+    tab_modrm[0x138] = tab_modrm[0x13a] = 1;  /* 3-byte maps: decoded, then giveup */
+    for (i = 0x40; i <= 0x4f; i++) tab_modrm[0x100|i] = 1;  /* cmov */
+    tab_modrm[0x150] = 1;                     /* movmskps/pd */
+    for (i = 0x54; i <= 0x5f; i++) tab_modrm[0x100|i] = 1;
+    for (i = 0x60; i <= 0x7f; i++) tab_modrm[0x100|i] = 1;
+    for (i = 0x90; i <= 0x9f; i++) tab_modrm[0x100|i] = 1;  /* setcc */
+    tab_modrm[0x1a3] = tab_modrm[0x1a4] = tab_modrm[0x1a5] = 1;
+    tab_modrm[0x1ab] = tab_modrm[0x1ac] = tab_modrm[0x1ad] = 1;
+    tab_modrm[0x1ae] = tab_modrm[0x1af] = 1;
+    for (i = 0xb0; i <= 0xbf; i++) tab_modrm[0x100|i] = 1;
+    for (i = 0xc0; i <= 0xc7; i++) tab_modrm[0x100|i] = 1;
+    for (i = 0xd0; i <= 0xfe; i++) tab_modrm[0x100|i] = 1;
+
+    for (i = 0x70; i <= 0x73; i++) tab_imm[0x100|i] = 1;
+    tab_imm[0x1a4] = tab_imm[0x1ac] = tab_imm[0x1ba] = 1;
+    tab_imm[0x1c2] = 1;
+    for (i = 0xc4; i <= 0xc6; i++) tab_imm[0x100|i] = 1;
+    for (i = 0x80; i <= 0x8f; i++) tab_imm[0x100|i] = 2;    /* jcc rel32 */
+}
+
+/*************************************************************************
+ * Small helpers
+ */
+static inline ULONGLONG sz_mask( UINT size )
+{
+    return size == 8 ? ~(ULONGLONG)0 : ((1ull << (size * 8)) - 1);
+}
+
+static inline ULONGLONG sz_sign( UINT size )
+{
+    return 1ull << (size * 8 - 1);
+}
+
+static inline ULONGLONG mem_read( ULONGLONG addr, UINT size )
+{
+    ULONGLONG v = 0;
+    memcpy( &v, (void *)(ULONG_PTR)addr, size );
+    return v;
+}
+
+static inline void mem_write( ULONGLONG addr, ULONGLONG v, UINT size )
+{
+    memcpy( (void *)(ULONG_PTR)addr, &v, size );
+}
+
+static inline ULONGLONG get_reg( const struct vkmt_x64_context *ctx, UINT idx, UINT size, BOOL rex )
+{
+    ULONGLONG v = ctx->gpr[idx & 15];
+    if (size == 1)
+    {
+        if (!rex && idx >= 4 && idx < 8) return (ctx->gpr[idx - 4] >> 8) & 0xff;  /* ah/ch/dh/bh */
+        return v & 0xff;
+    }
+    if (size == 2) return v & 0xffff;
+    if (size == 4) return (UINT)v;
+    return v;
+}
+
+static inline void set_reg( struct vkmt_x64_context *ctx, UINT idx, UINT size, BOOL rex, ULONGLONG v )
+{
+    if (size == 1)
+    {
+        if (!rex && idx >= 4 && idx < 8)
+            ctx->gpr[idx - 4] = (ctx->gpr[idx - 4] & ~0xff00ull) | ((v & 0xff) << 8);
+        else
+            ctx->gpr[idx] = (ctx->gpr[idx] & ~0xffull) | (v & 0xff);
+    }
+    else if (size == 2) ctx->gpr[idx] = (ctx->gpr[idx] & ~0xffffull) | (v & 0xffff);
+    else if (size == 4) ctx->gpr[idx] = (UINT)v;   /* 32-bit writes zero-extend */
+    else ctx->gpr[idx] = v;
+}
+
+static inline ULONGLONG get_rm( const struct vkmt_x64_context *ctx, const struct vkmt_insn *insn, UINT size )
+{
+    if (insn->rm_is_reg) return get_reg( ctx, insn->rm, size, insn->rex != 0 );
+    return mem_read( insn->ea, size );
+}
+
+static inline void set_rm( struct vkmt_x64_context *ctx, const struct vkmt_insn *insn, UINT size, ULONGLONG v )
+{
+    if (insn->rm_is_reg) set_reg( ctx, insn->rm, size, insn->rex != 0, v );
+    else mem_write( insn->ea, v, size );
+}
+
+static inline void push( struct vkmt_x64_context *ctx, ULONGLONG val )
+{
+    ctx->gpr[VKMT_RSP] -= 8;
+    mem_write( ctx->gpr[VKMT_RSP], val, 8 );
+}
+
+static inline ULONGLONG pop( struct vkmt_x64_context *ctx )
+{
+    ULONGLONG val = mem_read( ctx->gpr[VKMT_RSP], 8 );
+    ctx->gpr[VKMT_RSP] += 8;
+    return val;
+}
+
+static inline void branch_to( struct vkmt_x64_context *ctx, ULONGLONG target )
+{
+    ctx->branch_ring[ctx->branch_pos++ & 15] = target;
+    ctx->rip = target;
+}
+
+/*************************************************************************
+ * Decoder
+ */
+static void vkmt_decode( struct vkmt_x64_context *ctx, struct vkmt_insn *insn )
+{
+    const BYTE *ip = (const BYTE *)(ULONG_PTR)ctx->rip;
+    UINT op;
+    BOOL rip_rel = FALSE;
+    LONGLONG rip_disp = 0;
+
+    memset( insn, 0, sizeof(*insn) );
+    insn->start     = ip;
+    insn->rm_is_reg = TRUE;
+
+    for (;;)
+    {
+        switch (*ip)
+        {
+        case 0x66: insn->pref |= P_66; ip++; continue;
+        case 0xf2: insn->pref |= P_F2; ip++; continue;
+        case 0xf3: insn->pref |= P_F3; ip++; continue;
+        case 0xf0: insn->pref |= P_LOCK; ip++; continue;
+        case 0x2e: case 0x36: case 0x3e: case 0x26: ip++; continue;  /* ignored seg overrides */
+        case 0x64: insn->pref |= P_FS; ip++; continue;
+        case 0x65: insn->pref |= P_GS; ip++; continue;
+        case 0x67: ip++; continue;  /* addr-size override: not supported, assume rare */
+        default: break;
+        }
+        break;
+    }
+    if ((*ip & 0xf0) == 0x40) insn->rex = *ip++;
+
+    op = *ip++;
+    if (op == 0x0f) op = 0x100 | *ip++;
+    insn->opcode = op;
+
+    if (tab_modrm[op])
+    {
+        UINT modrm = *ip++;
+        UINT mod   = modrm >> 6;
+        UINT rex   = insn->rex;
+
+        insn->has_modrm = TRUE;
+        insn->reg = ((modrm >> 3) & 7) | ((rex & 4) << 1);
+        if (mod == 3)
+        {
+            insn->rm = (modrm & 7) | ((rex & 1) << 3);
+        }
+        else
+        {
+            ULONGLONG base = 0, disp = 0;
+            UINT rm = modrm & 7;
+
+            insn->rm_is_reg = FALSE;
+            if (rm == 4)  /* SIB */
+            {
+                UINT sib   = *ip++;
+                UINT idx   = (sib >> 3) & 7;
+                UINT b     = sib & 7;
+
+                if (idx != 4 || (rex & 2))
+                    base += ctx->gpr[idx | ((rex & 2) << 2)] << (sib >> 6);
+                if (b == 5 && mod == 0) { disp = (UINT)(INT)*(const INT *)ip; ip += 4; }
+                else base += ctx->gpr[b | ((rex & 1) << 3)];
+            }
+            else if (rm == 5 && mod == 0)  /* rip-relative */
+            {
+                rip_rel  = TRUE;
+                rip_disp = *(const INT *)ip;
+                ip += 4;
+            }
+            else base = ctx->gpr[rm | ((rex & 1) << 3)];
+
+            if (mod == 1)      { disp += (signed char)*ip; ip++; }
+            else if (mod == 2) { disp += (UINT)(INT)*(const INT *)ip; ip += 4; }
+            insn->ea = base + disp;
+        }
+    }
+
+    switch (tab_imm[op])
+    {
+    case 1: insn->imm_size = 1; break;
+    case 2: insn->imm_size = (insn->pref & P_66) ? 2 : 4; break;
+    case 3: insn->imm_size = (insn->rex & 8) ? 8 : ((insn->pref & P_66) ? 2 : 4); break;
+    case 4: insn->imm_size = 2; break;
+    case 5: insn->imm_size = 8; break;
+    case 6: /* enter imm16,imm8: store imm16 in imm, level in imm_size marker */
+        insn->imm = *(const USHORT *)ip;
+        ip += 2;
+        insn->imm |= (ULONGLONG)(*ip++) << 16;
+        insn->imm_size = 3;
+        break;
+    }
+    if (insn->imm_size && insn->imm_size != 3)
+    {
+        insn->imm = 0;
+        memcpy( &insn->imm, ip, insn->imm_size );
+        ip += insn->imm_size;
+    }
+
+    insn->len = ip - insn->start;
+    if (rip_rel) insn->ea = (ULONGLONG)(insn->start + insn->len) + rip_disp;
+    if (!insn->rm_is_reg)
+    {
+        if (insn->pref & P_FS) insn->ea += ctx->fsbase;
+        if (insn->pref & P_GS) insn->ea += ctx->gsbase;
+        if (insn->ea < 0x10000) insn->bad_ea = TRUE;  /* null-page operand: catch before the host faults */
+    }
+}
+
+/*************************************************************************
+ * Flags (always-compute model)
+ */
+static inline UINT parity8( UINT v )
+{
+    v ^= v >> 4;
+    return (0x6996 >> (v & 0xf)) & 1;
+}
+
+static void flags_szp( struct vkmt_x64_context *ctx, ULONGLONG res, UINT size )
+{
+    res &= sz_mask( size );
+    ctx->eflags &= ~(FL_SF | FL_ZF | FL_PF);
+    if (!res) ctx->eflags |= FL_ZF;
+    if (res & sz_sign( size )) ctx->eflags |= FL_SF;
+    if (parity8( (UINT)res )) ctx->eflags |= FL_PF;
+}
+
+/* add/sub/logic; op = x86 ALU group index: 0 add 1 or 2 adc 3 sbb 4 and 5 sub 6 xor 7 cmp(=sub) */
+static ULONGLONG alu_op( struct vkmt_x64_context *ctx, UINT op, ULONGLONG a,
+                         ULONGLONG b, UINT size, BOOL keep_cf )
+{
+    ULONGLONG m = sz_mask( size ), s = sz_sign( size ), r;
+    ULONG old_flags = ctx->eflags;
+    UINT cf_in = (op == 2 || op == 3) ? ((ctx->eflags & FL_CF) ? 1 : 0) : 0;
+
+    a &= m; b &= m;
+    if (op == 0 || op == 2)
+    {
+        r = a + b + cf_in;
+        ctx->eflags &= ~(FL_CF | FL_OF | FL_AF);
+        if (r > m) ctx->eflags |= FL_CF;
+        if ((a ^ b ^ r) & 0x10) ctx->eflags |= FL_AF;
+        if (~(a ^ b) & (a ^ r) & s) ctx->eflags |= FL_OF;
+        r &= m;
+    }
+    else if (op == 5 || op == 3 || op == 7)
+    {
+        r = a - b - cf_in;
+        ctx->eflags &= ~(FL_CF | FL_OF | FL_AF);
+        if (a < b + cf_in || (cf_in && b == m)) ctx->eflags |= FL_CF;
+        if ((a ^ b ^ r) & 0x10) ctx->eflags |= FL_AF;
+        if ((a ^ b) & (a ^ r) & s) ctx->eflags |= FL_OF;
+        r &= m;
+    }
+    else  /* or/and/xor */
+    {
+        if (op == 1) r = a | b;
+        else if (op == 4) r = a & b;
+        else r = a ^ b;
+        ctx->eflags &= ~(FL_CF | FL_OF | FL_AF);
+    }
+    if (keep_cf) ctx->eflags = (ctx->eflags & ~FL_CF) | (old_flags & FL_CF);
+    flags_szp( ctx, r, size );
+    return r;
+}
+
+/* group2 shifts/rotates; op = modrm.reg: 0 rol 1 ror 2 rcl 3 rcr 4/6 shl 5 shr 7 sar */
+static ULONGLONG shift_op( struct vkmt_x64_context *ctx, UINT op, ULONGLONG val,
+                           UINT count, UINT size )
+{
+    UINT bits = size * 8;
+    ULONGLONG m = sz_mask( size ), r = val & m;
+    UINT c = count & (size == 8 ? 63 : 31);
+
+    if (!c) return val & m;
+    ctx->eflags &= ~(FL_CF | FL_OF);
+    switch (op)
+    {
+    case 0:  /* rol */
+        c %= bits;
+        r = ((r << c) | (r >> (bits - c))) & m;
+        if (r & 1) ctx->eflags |= FL_CF;
+        if (c == 1 && ((r ^ (r >> 1)) & sz_sign(size))) ctx->eflags |= FL_OF;
+        return r;
+    case 1:  /* ror */
+        c %= bits;
+        r = (r >> c) | ((r << (bits - c)) & m);
+        if (r & sz_sign( size )) ctx->eflags |= FL_CF;
+        if (c == 1 && ((r ^ (r << 1)) & sz_sign(size))) ctx->eflags |= FL_OF;
+        return r & m;
+    case 2:  /* rcl */
+    {
+        UINT cf = (ctx->eflags & FL_CF) ? 1 : 0, i;
+        c %= (bits + 1);
+        for (i = 0; i < c; i++)
+        {
+            UINT newcf = (r & sz_sign( size )) ? 1 : 0;
+            r = ((r << 1) & m) | cf;
+            cf = newcf;
+        }
+        if (cf) ctx->eflags |= FL_CF;
+        if (c == 1 && (((r & sz_sign(size)) ? 1 : 0) != cf)) ctx->eflags |= FL_OF;
+        return r;
+    }
+    case 3:  /* rcr */
+    {
+        UINT cf = (ctx->eflags & FL_CF) ? 1 : 0, i;
+        c %= (bits + 1);
+        if (c == 1 && (((r & sz_sign(size)) ? 1 : 0) != cf)) ctx->eflags |= FL_OF;
+        for (i = 0; i < c; i++)
+        {
+            UINT newcf = r & 1;
+            r = (r >> 1) | (cf ? sz_sign( size ) : 0);
+            cf = newcf;
+        }
+        if (cf) ctx->eflags |= FL_CF;
+        return r;
+    }
+    case 4: case 6:  /* shl/sal */
+        if (c <= bits && ((r >> (bits - c)) & 1)) ctx->eflags |= FL_CF;
+        r = (r << c) & m;
+        if (c == 1 && (((r & sz_sign(size)) ? 1 : 0) != ((ctx->eflags & FL_CF) ? 1 : 0)))
+            ctx->eflags |= FL_OF;
+        flags_szp( ctx, r, size );
+        return r;
+    case 5:  /* shr */
+        if (c <= bits && ((r >> (c - 1)) & 1)) ctx->eflags |= FL_CF;
+        if (c == 1 && (val & sz_sign( size ))) ctx->eflags |= FL_OF;
+        r = c >= bits ? 0 : (r >> c);
+        flags_szp( ctx, r, size );
+        return r;
+    default: /* sar */
+    {
+        LONGLONG sv = (LONGLONG)(r | ((r & sz_sign( size )) ? ~m : 0));
+        if (c <= bits && ((sv >> (c - 1)) & 1)) ctx->eflags |= FL_CF;
+        r = (c >= bits) ? (sv < 0 ? m : 0) : (ULONGLONG)(sv >> c) & m;
+        flags_szp( ctx, r, size );
+        return r;
+    }
+    }
+}
+
+static BOOL eval_cc( const struct vkmt_x64_context *ctx, UINT cc )
+{
+    ULONG f = ctx->eflags;
+    switch (cc & 0xe)
+    {
+    case 0x0: return !!(f & FL_OF);
+    case 0x2: return !!(f & FL_CF);
+    case 0x4: return !!(f & FL_ZF);
+    case 0x6: return !!(f & (FL_CF | FL_ZF));
+    case 0x8: return !!(f & FL_SF);
+    case 0xa: return !!(f & FL_PF);
+    case 0xc: return ((f & FL_SF) != 0) != ((f & FL_OF) != 0);
+    case 0xe: return (f & FL_ZF) || (((f & FL_SF) != 0) != ((f & FL_OF) != 0));
+    }
+    return FALSE;
+}
+
+static inline BOOL cc_result( const struct vkmt_x64_context *ctx, UINT cc )
+{
+    BOOL r = eval_cc( ctx, cc );
+    return (cc & 1) ? !r : r;
+}
+
+/*************************************************************************
+ * Diagnostics
+ */
+static void giveup_dump( struct vkmt_x64_context *ctx, UINT opcode, const char *why );
+
+void vkmt_dump_guest( struct vkmt_x64_context *ctx, UINT opcode, const char *why )
+{
+    giveup_dump( ctx, opcode, why );
+}
+
+static void giveup_dump( struct vkmt_x64_context *ctx, UINT opcode, const char *why )
+{
+    static const char * const names[16] =
+        { "rax","rcx","rdx","rbx","rsp","rbp","rsi","rdi",
+          "r8","r9","r10","r11","r12","r13","r14","r15" };
+    const BYTE *ip = (const BYTE *)(ULONG_PTR)ctx->rip;
+    UINT i;
+
+    ERR( "GIVEUP: %s at rip %p opcode %03x\n", why, (void *)ctx->rip, opcode );
+    for (i = 0; i < 16; i += 4)
+        ERR( "  %-4s %016Ix  %-4s %016Ix  %-4s %016Ix  %-4s %016Ix\n",
+             names[i], ctx->gpr[i], names[i+1], ctx->gpr[i+1],
+             names[i+2], ctx->gpr[i+2], names[i+3], ctx->gpr[i+3] );
+    ERR( "  eflags %08lx  insns total %I64u\n", ctx->eflags, ctx->insn_total );
+    ERR( "  bytes at rip:" );
+    for (i = 0; i < 32; i++) ERR( " %02x", ip[i] );
+    ERR( "\n  last %u branch targets (oldest first):", ctx->branch_pos < 16 ? ctx->branch_pos : 16 );
+    {
+        UINT start = ctx->branch_pos > 16 ? ctx->branch_pos - 16 : 0;
+        for (i = start; i < ctx->branch_pos; i++) ERR( " %p", (void *)ctx->branch_ring[i & 15] );
+    }
+    ERR( "\n" );
+    {
+        UINT start = ctx->exec_pos > 8192 ? ctx->exec_pos - 8192 : 0;
+        ERR( "  last %u executed insns (rip eflags rax rcx; long tight loops elided):\n",
+             ctx->exec_pos - start > 8192 ? 8192 : ctx->exec_pos - start );
+        for (i = start; i < ctx->exec_pos; i++)
+        {
+            ULONGLONG rip = ctx->exec_ring[i & 8191][0];
+            /* elide repeated spins in ___chkstk_ms and similar 6-insn loops */
+            if (i + 10 < ctx->exec_pos && rip == ctx->exec_ring[(i - 5) & 8191][0] &&
+                rip == ctx->exec_ring[(i - 10) & 8191][0])
+                continue;
+            ERR( "    %p fl %08lx rax %016Ix rcx %016Ix\n",
+                 (void *)rip, (ULONG)ctx->exec_ring[i & 8191][1],
+                 ctx->exec_ring[i & 8191][2], ctx->exec_ring[i & 8191][3] );
+        }
+    }
+}
+
+/*************************************************************************
+ * String operations
+ */
+static void op_string( struct vkmt_x64_context *ctx, const struct vkmt_insn *insn, UINT op, UINT size )
+{
+    BOOL rep  = (insn->pref & (P_F2 | P_F3)) != 0;
+    BOOL repe = (insn->pref & P_F3) != 0;
+    LONGLONG step = (ctx->eflags & FL_DF) ? -(LONGLONG)size : (LONGLONG)size;
+
+    /* fast paths */
+    if (rep && (ctx->eflags & FL_DF) == 0 && op == 0xa4 && size == 1)  /* rep movsb */
+    {
+        ULONGLONG n = ctx->gpr[VKMT_RCX];
+        memmove( (void *)(ULONG_PTR)ctx->gpr[VKMT_RDI], (void *)(ULONG_PTR)ctx->gpr[VKMT_RSI], n );
+        ctx->gpr[VKMT_RDI] += n; ctx->gpr[VKMT_RSI] += n; ctx->gpr[VKMT_RCX] = 0;
+        return;
+    }
+    if (rep && (ctx->eflags & FL_DF) == 0 && op == 0xaa && size == 1)  /* rep stosb */
+    {
+        ULONGLONG n = ctx->gpr[VKMT_RCX];
+        memset( (void *)(ULONG_PTR)ctx->gpr[VKMT_RDI], (UINT)ctx->gpr[VKMT_RAX], n );
+        ctx->gpr[VKMT_RDI] += n; ctx->gpr[VKMT_RCX] = 0;
+        return;
+    }
+
+    for (;;)
+    {
+        if (rep && !ctx->gpr[VKMT_RCX]) break;
+        switch (op)
+        {
+        case 0xa4:  /* movs */
+            mem_write( ctx->gpr[VKMT_RDI], mem_read( ctx->gpr[VKMT_RSI], size ), size );
+            ctx->gpr[VKMT_RDI] += step; ctx->gpr[VKMT_RSI] += step;
+            break;
+        case 0xaa:  /* stos */
+            mem_write( ctx->gpr[VKMT_RDI], ctx->gpr[VKMT_RAX], size );
+            ctx->gpr[VKMT_RDI] += step;
+            break;
+        case 0xac:  /* lods */
+            set_reg( ctx, VKMT_RAX, size, TRUE, mem_read( ctx->gpr[VKMT_RSI], size ) );
+            ctx->gpr[VKMT_RSI] += step;
+            break;
+        case 0xae:  /* scas */
+            alu_op( ctx, 5, get_reg( ctx, VKMT_RAX, size, TRUE ),
+                    mem_read( ctx->gpr[VKMT_RDI], size ), size, FALSE );
+            ctx->gpr[VKMT_RDI] += step;
+            break;
+        case 0xa6:  /* cmps */
+            alu_op( ctx, 5, mem_read( ctx->gpr[VKMT_RSI], size ),
+                    mem_read( ctx->gpr[VKMT_RDI], size ), size, FALSE );
+            ctx->gpr[VKMT_RDI] += step; ctx->gpr[VKMT_RSI] += step;
+            break;
+        }
+        if (!rep) break;
+        ctx->gpr[VKMT_RCX]--;
+        if (op == 0xae || op == 0xa6)
+        {
+            if (repe && !(ctx->eflags & FL_ZF)) break;
+            if (!repe && (ctx->eflags & FL_ZF)) break;
+        }
+    }
+}
+
+/*************************************************************************
+ * CPUID / RDTSC
+ */
+static void op_cpuid( struct vkmt_x64_context *ctx )
+{
+    UINT leaf = (UINT)ctx->gpr[VKMT_RAX];
+    UINT a = 0, b = 0, c = 0, d = 0;
+    static const char brand[] = "VKMT x86-64 Virtual CPU (interp M3) ";  /* 48 bytes padded */
+
+    switch (leaf)
+    {
+    case 0:
+        a = 7;
+        b = 0x756e6547; c = 0x6c65746e; d = 0x49656e69;  /* "GenuineIntel" */
+        break;
+    case 1:
+        a = 0x000806e9;  /* family 6 model 142 */
+        b = ((GetCurrentThreadId() & 0xff) << 24) | (8 << 8);
+        c = (1 << 0)  /* SSE3 */    | (1 << 9)  /* SSSE3 */  | (1 << 13) /* CMPXCHG16B */
+          | (1 << 19) /* SSE4.1 */  | (1 << 20) /* SSE4.2 */ | (1 << 23) /* POPCNT */;
+        d = (1 << 0)  /* FPU */     | (1 << 4)  /* TSC */    | (1 << 5)  /* MSR */
+          | (1 << 8)  /* CX8 */     | (1 << 15) /* CMOV */   | (1 << 19) /* CLFLUSH */
+          | (1 << 23) /* MMX */     | (1 << 24) /* FXSR */   | (1 << 25) /* SSE */
+          | (1 << 26) /* SSE2 */;
+        break;
+    case 7:
+        a = b = c = d = 0;
+        break;
+    case 0x80000000:
+        a = 0x80000008;
+        break;
+    case 0x80000001:
+        c = 1 << 0;  /* LAHF/SAHF in 64-bit mode */
+        d = (1 << 20) /* NX */ | (1 << 27) /* RDTSCP */ | (1 << 29) /* long mode */;
+        break;
+    case 0x80000002: case 0x80000003: case 0x80000004:
+    {
+        UINT off = (leaf - 0x80000002) * 16;
+        memcpy( &a, brand + off, 4 ); memcpy( &b, brand + off + 4, 4 );
+        memcpy( &c, brand + off + 8, 4 ); memcpy( &d, brand + off + 12, 4 );
+        break;
+    }
+    case 0x80000006:
+        c = (8 << 12) /* 8-way L2 */ | 64 /* line */ | (1 << 16) /* 64K? -> keep small */;
+        break;
+    case 0x80000008:
+        a = (48 << 8) | 48;  /* virt/phys addr bits */
+        b = 0;
+        c = d = 0;
+        break;
+    default:
+        a = b = c = d = 0;
+        break;
+    }
+    ctx->gpr[VKMT_RAX] = a; ctx->gpr[VKMT_RBX] = b;
+    ctx->gpr[VKMT_RCX] = c; ctx->gpr[VKMT_RDX] = d;
+}
+
+static ULONGLONG read_tsc(void)
+{
+    static LARGE_INTEGER freq;
+    LARGE_INTEGER now;
+
+    if (!freq.QuadPart) NtQueryPerformanceCounter( &now, &freq );
+    NtQueryPerformanceCounter( &now, NULL );
+    return (ULONGLONG)((double)now.QuadPart * 3000000000.0 / (double)freq.QuadPart);
+}
+
+/* PE link has no libm (-nodefaultlibs): local implementations.
+ * sqrt: Newton refinement from a bit-hack seed (correctly rounded except
+ * possibly the last ulp in rare cases; good enough for CRT/printf).
+ * rne: round-to-nearest-even (mxcsr default rounding). */
+static double vkmt_sqrtd( double x )
+{
+    union { double d; ULONGLONG u; } v;
+    double y;
+    UINT i;
+
+    if (x != x) return x;      /* NaN */
+    if (x < 0.0) { v.u = 0x7ff8000000000000ull; return v.d; }  /* NaN */
+    if (x == 0.0) return x;
+    v.d = x;
+    v.u = (v.u >> 1) + 0x1ff7a3bea91d9b1bull;
+    y = v.d;
+    for (i = 0; i < 6; i++) y = 0.5 * (y + x / y);
+    return y;
+}
+
+static float vkmt_sqrtf( float x )
+{
+    return (float)vkmt_sqrtd( (double)x );
+}
+
+static LONGLONG vkmt_rned( double d )
+{
+    LONGLONG t = (LONGLONG)d;   /* truncates toward zero */
+    double frac = d - (double)t;
+
+    if (frac > 0.5 || (frac == 0.5 && (t & 1))) t++;
+    else if (frac < -0.5 || (frac == -0.5 && (t & 1))) t--;
+    return t;
+}
+
+static LONGLONG vkmt_rnef( float f )
+{
+    return vkmt_rned( (double)f );
+}
+
+
+/*************************************************************************
+ * SSE helpers
+ */
+static inline void xmm_get( const struct vkmt_x64_context *ctx, UINT idx, BYTE out[16] )
+{
+    memcpy( out, &ctx->xmm[idx & 15], 16 );
+}
+
+static inline void xmm_put( struct vkmt_x64_context *ctx, UINT idx, const BYTE in[16] )
+{
+    memcpy( &ctx->xmm[idx & 15], in, 16 );
+}
+
+static void get_rm128( const struct vkmt_x64_context *ctx, const struct vkmt_insn *insn, BYTE out[16] )
+{
+    if (insn->rm_is_reg) xmm_get( ctx, insn->rm, out );
+    else memcpy( out, (void *)(ULONG_PTR)insn->ea, 16 );
+}
+
+static void set_rm128( struct vkmt_x64_context *ctx, const struct vkmt_insn *insn, const BYTE in[16] )
+{
+    if (insn->rm_is_reg) xmm_put( ctx, insn->rm, in );
+    else memcpy( (void *)(ULONG_PTR)insn->ea, in, 16 );
+}
+
+/* elementwise helpers over 16-byte vectors */
+#define SSE_BINOP_FLOAT( type, n, op )                                          \
+    do {                                                                        \
+        type dv[n], sv[n];                                                      \
+        UINT i_;                                                                \
+        memcpy( dv, dst, sizeof(dv) ); memcpy( sv, src, sizeof(sv) );           \
+        for (i_ = 0; i_ < n; i_++) dv[i_] = dv[i_] op sv[i_];                   \
+        memcpy( dst, dv, sizeof(dv) );                                          \
+    } while (0)
+
+static void sse_arith( struct vkmt_x64_context *ctx, const struct vkmt_insn *insn, UINT base_op )
+{
+    /* base_op 0 add,1 mul,4 sub,5 min,6 div,7 max,2 sqrt */
+    BOOL dbl  = (insn->pref & P_66) || (insn->pref & P_F2);   /* pd or sd */
+    BOOL scal = (insn->pref & (P_F2 | P_F3)) != 0;            /* ss/sd */
+    BYTE dst[16], src[16];
+
+    xmm_get( ctx, insn->reg, dst );
+    get_rm128( ctx, insn, src );
+
+    if (base_op == 2)  /* sqrt */
+    {
+        if (dbl)
+        {
+            double dv[2]; UINT n = scal ? 1 : 2, i;
+            memcpy( dv, dst, 16 );
+            for (i = 0; i < n; i++) dv[i] = vkmt_sqrtd( dv[i] );
+            memcpy( dst, dv, 16 );
+        }
+        else
+        {
+            float fv[4]; UINT n = scal ? 1 : 4, i;
+            memcpy( fv, dst, 16 );
+            for (i = 0; i < n; i++) fv[i] = vkmt_sqrtf( fv[i] );
+            memcpy( dst, fv, 16 );
+        }
+    }
+    else if (dbl)
+    {
+        double dv[2], sv[2]; UINT n = scal ? 1 : 2, i;
+        memcpy( dv, dst, 16 ); memcpy( sv, src, 16 );
+        for (i = 0; i < n; i++)
+        {
+            switch (base_op)
+            {
+            case 0: dv[i] += sv[i]; break;
+            case 1: dv[i] *= sv[i]; break;
+            case 4: dv[i] -= sv[i]; break;
+            case 5: dv[i] = (sv[i] < dv[i] || isnan(sv[i])) ? sv[i] : dv[i]; break;
+            case 6: dv[i] /= sv[i]; break;
+            case 7: dv[i] = (sv[i] > dv[i] || isnan(sv[i])) ? sv[i] : dv[i]; break;
+            }
+        }
+        memcpy( dst, dv, 16 );
+    }
+    else
+    {
+        float fv[4], sv[4]; UINT n = scal ? 1 : 4, i;
+        memcpy( fv, dst, 16 ); memcpy( sv, src, 16 );
+        for (i = 0; i < n; i++)
+        {
+            switch (base_op)
+            {
+            case 0: fv[i] += sv[i]; break;
+            case 1: fv[i] *= sv[i]; break;
+            case 4: fv[i] -= sv[i]; break;
+            case 5: fv[i] = (sv[i] < fv[i] || isnan(sv[i])) ? sv[i] : fv[i]; break;
+            case 6: fv[i] /= sv[i]; break;
+            case 7: fv[i] = (sv[i] > fv[i] || isnan(sv[i])) ? sv[i] : fv[i]; break;
+            }
+        }
+        memcpy( dst, fv, 16 );
+    }
+    xmm_put( ctx, insn->reg, dst );
+}
+
+/*************************************************************************
+ * Execute stage.  Returns FALSE when the interpreter must stop (giveup;
+ * the outcome is filled by the caller using ctx->rip).
+ */
+static BOOL vkmt_execute( struct vkmt_x64_context *ctx, const struct vkmt_insn *insn );
+
+/* integer part, primary map */
+static BOOL exec_primary( struct vkmt_x64_context *ctx, const struct vkmt_insn *insn )
+{
+    UINT op = insn->opcode;
+    UINT opsize = (insn->rex & 8) ? 8 : ((insn->pref & P_66) ? 2 : 4);
+
+    if (op <= 0x3f && (op & 7) <= 5 && (op >> 3) <= 7 &&
+        !((op & 0xc7) == 0x06 || (op & 0xc7) == 0x07 || (op & 0xc7) == 0x0e ||
+          (op & 0xc7) == 0x16 || (op & 0xc7) == 0x17 || (op & 0xc7) == 0x1e ||
+          op == 0x27 || op == 0x2f || op == 0x37 || op == 0x3f))
+    {
+        /* ALU block: add/or/adc/sbb/and/sub/xor/cmp in all six forms */
+        UINT alu  = (op >> 3) & 7;
+        UINT form = op & 7;
+        ULONGLONG a, b, r = 0;
+        UINT size = (form == 0 || form == 2 || form == 4) ? 1 : opsize;
+
+        switch (form)
+        {
+        case 0: case 1:  /* op r/m, r */
+            a = get_rm( ctx, insn, size );
+            b = get_reg( ctx, insn->reg, size, insn->rex != 0 );
+            r = alu_op( ctx, alu, a, b, size, FALSE );
+            if (alu != 7)
+            {
+                if (insn->pref & P_LOCK && !insn->rm_is_reg && alu != 2 && alu != 3)
+                {
+                    /* locked rmw: use host atomics for thread safety */
+                    switch (size)
+                    {
+                    case 1: if (alu == 0) __atomic_fetch_add( (BYTE *)(ULONG_PTR)insn->ea, (BYTE)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 5) __atomic_fetch_sub( (BYTE *)(ULONG_PTR)insn->ea, (BYTE)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 1) __atomic_fetch_or( (BYTE *)(ULONG_PTR)insn->ea, (BYTE)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 4) __atomic_fetch_and( (BYTE *)(ULONG_PTR)insn->ea, (BYTE)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 6) __atomic_fetch_xor( (BYTE *)(ULONG_PTR)insn->ea, (BYTE)b, __ATOMIC_SEQ_CST );
+                            break;
+                    case 2: if (alu == 0) __atomic_fetch_add( (USHORT *)(ULONG_PTR)insn->ea, (USHORT)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 5) __atomic_fetch_sub( (USHORT *)(ULONG_PTR)insn->ea, (USHORT)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 1) __atomic_fetch_or( (USHORT *)(ULONG_PTR)insn->ea, (USHORT)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 4) __atomic_fetch_and( (USHORT *)(ULONG_PTR)insn->ea, (USHORT)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 6) __atomic_fetch_xor( (USHORT *)(ULONG_PTR)insn->ea, (USHORT)b, __ATOMIC_SEQ_CST );
+                            break;
+                    case 4: if (alu == 0) __atomic_fetch_add( (UINT *)(ULONG_PTR)insn->ea, (UINT)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 5) __atomic_fetch_sub( (UINT *)(ULONG_PTR)insn->ea, (UINT)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 1) __atomic_fetch_or( (UINT *)(ULONG_PTR)insn->ea, (UINT)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 4) __atomic_fetch_and( (UINT *)(ULONG_PTR)insn->ea, (UINT)b, __ATOMIC_SEQ_CST );
+                            else if (alu == 6) __atomic_fetch_xor( (UINT *)(ULONG_PTR)insn->ea, (UINT)b, __ATOMIC_SEQ_CST );
+                            break;
+                    default: if (alu == 0) __atomic_fetch_add( (ULONGLONG *)(ULONG_PTR)insn->ea, b, __ATOMIC_SEQ_CST );
+                            else if (alu == 5) __atomic_fetch_sub( (ULONGLONG *)(ULONG_PTR)insn->ea, b, __ATOMIC_SEQ_CST );
+                            else if (alu == 1) __atomic_fetch_or( (ULONGLONG *)(ULONG_PTR)insn->ea, b, __ATOMIC_SEQ_CST );
+                            else if (alu == 4) __atomic_fetch_and( (ULONGLONG *)(ULONG_PTR)insn->ea, b, __ATOMIC_SEQ_CST );
+                            else if (alu == 6) __atomic_fetch_xor( (ULONGLONG *)(ULONG_PTR)insn->ea, b, __ATOMIC_SEQ_CST );
+                            break;
+                    }
+                }
+                else set_rm( ctx, insn, size, r );
+            }
+            break;
+        case 2: case 3:  /* op r, r/m */
+            a = get_reg( ctx, insn->reg, size, insn->rex != 0 );
+            b = get_rm( ctx, insn, size );
+            r = alu_op( ctx, alu, a, b, size, FALSE );
+            if (alu != 7) set_reg( ctx, insn->reg, size, insn->rex != 0, r );
+            break;
+        case 4: case 5:  /* op AL/rAX, imm */
+            a = get_reg( ctx, VKMT_RAX, size, insn->rex != 0 );
+            b = insn->imm;
+            if (size != 1 && insn->imm_size < size) b = (ULONGLONG)(LONGLONG)(INT)insn->imm;
+            if (size == 2) b = (SHORT)insn->imm;
+            r = alu_op( ctx, alu, a, b, size, FALSE );
+            if (alu != 7) set_reg( ctx, VKMT_RAX, size, insn->rex != 0, r );
+            break;
+        }
+        ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+        return TRUE;
+    }
+
+    switch (op)
+    {
+    case 0x50: case 0x51: case 0x52: case 0x53: case 0x54: case 0x55: case 0x56: case 0x57:
+        push( ctx, ctx->gpr[(op & 7) | ((insn->rex & 1) << 3)] );
+        break;
+    case 0x58: case 0x59: case 0x5a: case 0x5b: case 0x5c: case 0x5d: case 0x5e: case 0x5f:
+        set_reg( ctx, (op & 7) | ((insn->rex & 1) << 3), 8, TRUE, pop( ctx ) );
+        break;
+    case 0x63:  /* movsxd */
+        set_reg( ctx, insn->reg, opsize, insn->rex != 0,
+                 (ULONGLONG)(LONGLONG)(INT)get_rm( ctx, insn, 4 ) );
+        break;
+    case 0x68:  /* push immz */
+        push( ctx, (ULONGLONG)(LONGLONG)(INT)insn->imm );
+        break;
+    case 0x6a:  /* push imm8 */
+        push( ctx, (ULONGLONG)(LONGLONG)(signed char)insn->imm );
+        break;
+    case 0x69:  /* imul r, r/m, immz */
+    {
+        LONGLONG a = (LONGLONG)get_rm( ctx, insn, opsize );
+        LONGLONG b = (LONGLONG)(INT)insn->imm;
+        if (opsize == 2) { a = (SHORT)a; b = (SHORT)b; }
+        if (opsize == 4) { a = (INT)a; }
+        if (opsize == 8)
+        {
+            __int128 full = (__int128)a * b;
+            set_reg( ctx, insn->reg, opsize, insn->rex != 0, (ULONGLONG)full );
+            ctx->eflags &= ~(FL_CF | FL_OF);
+            if (full != (LONGLONG)full) ctx->eflags |= FL_CF | FL_OF;
+        }
+        else
+        {
+            LONGLONG full = a * b;
+            set_reg( ctx, insn->reg, opsize, insn->rex != 0, (ULONGLONG)full );
+            ctx->eflags &= ~(FL_CF | FL_OF);
+            if (opsize == 4 ? full != (INT)full : full != (SHORT)full) ctx->eflags |= FL_CF | FL_OF;
+        }
+        break;
+    }
+    case 0x6b:  /* imul r, r/m, imm8 */
+    {
+        LONGLONG a = (LONGLONG)get_rm( ctx, insn, opsize );
+        LONGLONG b = (signed char)insn->imm;
+        if (opsize == 2) a = (SHORT)a;
+        if (opsize == 4) a = (INT)a;
+        if (opsize == 8)
+        {
+            __int128 full = (__int128)a * b;
+            set_reg( ctx, insn->reg, opsize, insn->rex != 0, (ULONGLONG)full );
+            ctx->eflags &= ~(FL_CF | FL_OF);
+            if (full != (LONGLONG)full) ctx->eflags |= FL_CF | FL_OF;
+        }
+        else
+        {
+            LONGLONG full = a * b;
+            set_reg( ctx, insn->reg, opsize, insn->rex != 0, (ULONGLONG)full );
+            ctx->eflags &= ~(FL_CF | FL_OF);
+            if (opsize == 4 ? full != (INT)full : full != (SHORT)full) ctx->eflags |= FL_CF | FL_OF;
+        }
+        break;
+    }
+    case 0x70: case 0x71: case 0x72: case 0x73: case 0x74: case 0x75: case 0x76: case 0x77:
+    case 0x78: case 0x79: case 0x7a: case 0x7b: case 0x7c: case 0x7d: case 0x7e: case 0x7f:
+        if (cc_result( ctx, op & 0xf ))
+            branch_to( ctx, (ULONG_PTR)(insn->start + insn->len + (signed char)insn->imm) );
+        else
+            ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+        return TRUE;
+    case 0x80: case 0x82: case 0x81: case 0x83:  /* group1 alu r/m, imm */
+    {
+        UINT alu = insn->reg & 7;
+        UINT size = (op == 0x80 || op == 0x82) ? 1 : opsize;
+        ULONGLONG a, b, r;
+        if (op == 0x83) b = (ULONGLONG)(LONGLONG)(signed char)insn->imm;
+        else if (size == 1) b = insn->imm & 0xff;
+        else if (size == 2) b = (SHORT)insn->imm;
+        else b = (ULONGLONG)(LONGLONG)(INT)insn->imm;
+        a = get_rm( ctx, insn, size );
+        r = alu_op( ctx, alu, a, b, size, FALSE );
+        if (alu != 7) set_rm( ctx, insn, size, r );
+        break;
+    }
+    case 0x84: case 0x85:  /* test */
+    {
+        UINT size = (op == 0x84) ? 1 : opsize;
+        alu_op( ctx, 4, get_rm( ctx, insn, size ),
+                get_reg( ctx, insn->reg, size, insn->rex != 0 ), size, FALSE );
+        break;
+    }
+    case 0x86: case 0x87:  /* xchg */
+    {
+        UINT size = (op == 0x86) ? 1 : opsize;
+        ULONGLONG a = get_rm( ctx, insn, size );
+        ULONGLONG b = get_reg( ctx, insn->reg, size, insn->rex != 0 );
+        if (insn->pref & P_LOCK && !insn->rm_is_reg)
+        {
+            ULONGLONG cur = get_reg( ctx, insn->reg, size, insn->rex != 0 );
+            if (size == 8) __atomic_exchange_n( (ULONGLONG *)(ULONG_PTR)insn->ea, cur, __ATOMIC_SEQ_CST );
+            else if (size == 4) __atomic_exchange_n( (UINT *)(ULONG_PTR)insn->ea, (UINT)cur, __ATOMIC_SEQ_CST );
+            else if (size == 2) __atomic_exchange_n( (USHORT *)(ULONG_PTR)insn->ea, (USHORT)cur, __ATOMIC_SEQ_CST );
+            else __atomic_exchange_n( (BYTE *)(ULONG_PTR)insn->ea, (BYTE)cur, __ATOMIC_SEQ_CST );
+            /* note: lock xchg doesn't change the reg */
+            break;
+        }
+        set_rm( ctx, insn, size, b );
+        set_reg( ctx, insn->reg, size, insn->rex != 0, a );
+        break;
+    }
+    case 0x88: case 0x89:  /* mov r/m, r */
+    {
+        UINT size = (op == 0x88) ? 1 : opsize;
+        set_rm( ctx, insn, size, get_reg( ctx, insn->reg, size, insn->rex != 0 ) );
+        break;
+    }
+    case 0x8a: case 0x8b:  /* mov r, r/m */
+    {
+        UINT size = (op == 0x8a) ? 1 : opsize;
+        set_reg( ctx, insn->reg, size, insn->rex != 0, get_rm( ctx, insn, size ) );
+        break;
+    }
+    case 0x8c:  /* mov r/m16, sreg — segment regs unsupported */
+        giveup_dump( ctx, op, "mov from segment register" );
+        return FALSE;
+    case 0x8d:  /* lea */
+        set_reg( ctx, insn->reg, opsize, insn->rex != 0, insn->ea );
+        break;
+    case 0x8e:
+        giveup_dump( ctx, op, "mov to segment register" );
+        return FALSE;
+    case 0x8f:  /* pop r/m64 */
+        set_rm( ctx, insn, 8, pop( ctx ) );
+        break;
+    case 0x90:  /* nop / pause; with REX.B it's xchg r8,rax */
+        if (insn->rex & 1)
+        {
+            ULONGLONG t = ctx->gpr[VKMT_RAX];
+            ctx->gpr[VKMT_RAX] = ctx->gpr[8];
+            ctx->gpr[8] = t;
+        }
+        break;
+    case 0x91: case 0x92: case 0x93: case 0x94: case 0x95: case 0x96: case 0x97:
+    {
+        UINT idx = (op & 7) | ((insn->rex & 1) << 3);
+        ULONGLONG a = get_reg( ctx, VKMT_RAX, opsize, TRUE );
+        ULONGLONG b = get_reg( ctx, idx, opsize, TRUE );
+        set_reg( ctx, VKMT_RAX, opsize, TRUE, b );
+        set_reg( ctx, idx, opsize, TRUE, a );
+        break;
+    }
+    case 0x98:  /* cbw/cwde/cdqe */
+        if (insn->rex & 8) ctx->gpr[VKMT_RAX] = (ULONGLONG)(LONGLONG)(INT)ctx->gpr[VKMT_RAX];
+        else if (insn->pref & P_66)
+            ctx->gpr[VKMT_RAX] = (ctx->gpr[VKMT_RAX] & ~0xffffull) |
+                                 (USHORT)(short)(signed char)ctx->gpr[VKMT_RAX];
+        else ctx->gpr[VKMT_RAX] = (UINT)(INT)(SHORT)ctx->gpr[VKMT_RAX];
+        break;
+    case 0x99:  /* cwd/cdq/cqo */
+        if (insn->rex & 8)
+            ctx->gpr[VKMT_RDX] = (ctx->gpr[VKMT_RAX] & sz_sign(8)) ? ~0ull : 0;
+        else if (insn->pref & P_66)
+            ctx->gpr[VKMT_RDX] = (ctx->gpr[VKMT_RDX] & ~0xffffull) |
+                                 ((ctx->gpr[VKMT_RAX] & 0x8000) ? 0xffff : 0);
+        else ctx->gpr[VKMT_RDX] = (ctx->gpr[VKMT_RAX] & 0x80000000) ? 0xffffffff : 0;
+        break;
+    case 0x9b:  /* fwait */
+        break;
+    case 0x9c:  /* pushf */
+        push( ctx, ctx->eflags | 0x202 );
+        break;
+    case 0x9d:  /* popf */
+        ctx->eflags = (UINT)(pop( ctx ) & 0x244fd5) | 0x202;
+        break;
+    case 0x9e:  /* sahf */
+        ctx->eflags = (ctx->eflags & ~(FL_SF|FL_ZF|FL_AF|FL_PF|FL_CF)) |
+                      ((UINT)(ctx->gpr[VKMT_RAX] >> 8) & (FL_SF|FL_ZF|FL_AF|FL_PF|FL_CF));
+        break;
+    case 0x9f:  /* lahf */
+        ctx->gpr[VKMT_RAX] = (ctx->gpr[VKMT_RAX] & ~0xff00ull) |
+                             (((ULONGLONG)(ctx->eflags & 0xff) | 0x02) << 8);
+        break;
+    case 0xa0: case 0xa1:  /* mov AL/rAX, moffs */
+        set_reg( ctx, VKMT_RAX, op == 0xa0 ? 1 : opsize, insn->rex != 0,
+                 mem_read( insn->imm + ((insn->pref & P_FS) ? ctx->fsbase :
+                                        (insn->pref & P_GS) ? ctx->gsbase : 0),
+                           op == 0xa0 ? 1 : opsize ) );
+        break;
+    case 0xa2: case 0xa3:  /* mov moffs, AL/rAX */
+        mem_write( insn->imm + ((insn->pref & P_FS) ? ctx->fsbase :
+                                (insn->pref & P_GS) ? ctx->gsbase : 0),
+                   get_reg( ctx, VKMT_RAX, op == 0xa2 ? 1 : opsize, insn->rex != 0 ),
+                   op == 0xa2 ? 1 : opsize );
+        break;
+    case 0xa4: op_string( ctx, insn, 0xa4, 1 ); break;
+    case 0xa5: op_string( ctx, insn, 0xa4, opsize ); break;
+    case 0xa6: op_string( ctx, insn, 0xa6, 1 ); break;
+    case 0xa7: op_string( ctx, insn, 0xa6, opsize ); break;
+    case 0xa8: case 0xa9:  /* test AL/rAX, imm */
+    {
+        UINT size = (op == 0xa8) ? 1 : opsize;
+        ULONGLONG b = insn->imm;
+        if (size == 2) b = (SHORT)b; else if (size > 1 && insn->imm_size < size) b = (ULONGLONG)(LONGLONG)(INT)b;
+        alu_op( ctx, 4, get_reg( ctx, VKMT_RAX, size, insn->rex != 0 ), b, size, FALSE );
+        break;
+    }
+    case 0xaa: op_string( ctx, insn, 0xaa, 1 ); break;
+    case 0xab: op_string( ctx, insn, 0xaa, opsize ); break;
+    case 0xac: op_string( ctx, insn, 0xac, 1 ); break;
+    case 0xad: op_string( ctx, insn, 0xac, opsize ); break;
+    case 0xae: op_string( ctx, insn, 0xae, 1 ); break;
+    case 0xaf: op_string( ctx, insn, 0xae, opsize ); break;
+    case 0xb0: case 0xb1: case 0xb2: case 0xb3: case 0xb4: case 0xb5: case 0xb6: case 0xb7:
+        set_reg( ctx, (op & 7) | ((insn->rex & 1) << 3), 1, insn->rex != 0, insn->imm & 0xff );
+        break;
+    case 0xb8: case 0xb9: case 0xba: case 0xbb: case 0xbc: case 0xbd: case 0xbe: case 0xbf:
+        set_reg( ctx, (op & 7) | ((insn->rex & 1) << 3), opsize, TRUE, insn->imm );
+        break;
+    case 0xc0: case 0xc1: case 0xd0: case 0xd1: case 0xd2: case 0xd3:  /* shifts */
+    {
+        UINT size = (op == 0xc0 || op == 0xd0 || op == 0xd2) ? 1 : opsize;
+        UINT count;
+        if (op == 0xc0 || op == 0xc1) count = (UINT)insn->imm;
+        else if (op == 0xd0 || op == 0xd1) count = 1;
+        else count = (UINT)ctx->gpr[VKMT_RCX];
+        set_rm( ctx, insn, size, shift_op( ctx, insn->reg & 7, get_rm( ctx, insn, size ), count, size ) );
+        break;
+    }
+    case 0xc2:  /* ret imm16 */
+        branch_to( ctx, pop( ctx ) );
+        ctx->gpr[VKMT_RSP] += insn->imm & 0xffff;
+        return TRUE;
+    case 0xc3:  /* ret */
+        branch_to( ctx, pop( ctx ) );
+        return TRUE;
+    case 0xc6: case 0xc7:  /* mov r/m, imm */
+    {
+        UINT size = (op == 0xc6) ? 1 : opsize;
+        ULONGLONG b = insn->imm;
+        if (size == 2) b &= 0xffff;
+        else if (size == 8) b = (ULONGLONG)(LONGLONG)(INT)b;
+        set_rm( ctx, insn, size, b );
+        break;
+    }
+    case 0xc8:  /* enter */
+    {
+        ULONGLONG frame = insn->imm & 0xffff;
+        UINT level = (UINT)((insn->imm >> 16) & 31), i;
+        push( ctx, ctx->gpr[VKMT_RBP] );
+        if (level)
+        {
+            ULONGLONG temp = ctx->gpr[VKMT_RSP];
+            for (i = 1; i < level; i++)
+            {
+                ctx->gpr[VKMT_RBP] -= 8;
+                push( ctx, mem_read( ctx->gpr[VKMT_RBP], 8 ) );
+            }
+            push( ctx, temp );
+        }
+        ctx->gpr[VKMT_RBP] = ctx->gpr[VKMT_RSP];
+        ctx->gpr[VKMT_RSP] -= frame;
+        break;
+    }
+    case 0xc9:  /* leave */
+        ctx->gpr[VKMT_RSP] = ctx->gpr[VKMT_RBP];
+        ctx->gpr[VKMT_RBP] = pop( ctx );
+        break;
+    case 0xcc:  /* int3 */
+        giveup_dump( ctx, op, "guest int3 breakpoint" );
+        return FALSE;
+    case 0xd7:  /* xlat */
+        ctx->gpr[VKMT_RAX] = (ctx->gpr[VKMT_RAX] & ~0xffull) |
+            mem_read( ctx->gpr[VKMT_RBX] + (ctx->gpr[VKMT_RAX] & 0xff), 1 );
+        break;
+    case 0xd9:  /* x87 escape: fldcw/fnstcw only */
+        if (insn->rm_is_reg) goto x87_giveup;
+        if ((insn->reg & 7) == 5) ctx->fcw = (USHORT)mem_read( insn->ea, 2 );
+        else if ((insn->reg & 7) == 7) mem_write( insn->ea, ctx->fcw, 2 );
+        else goto x87_giveup;
+        break;
+    case 0xdb:
+        if (insn->rm_is_reg && (insn->rm & 7) == 3 && (insn->reg & 7) == 4)  /* fninit (db e3) */
+        {
+            ctx->fcw = 0x27f; ctx->fsw = 0;
+            break;
+        }
+        goto x87_giveup;
+    case 0xdf:
+        if (insn->rm_is_reg && (insn->reg & 7) == 4 && (insn->rm & 7) == 0)  /* fnstsw ax (df e0) */
+        {
+            ctx->gpr[VKMT_RAX] = (ctx->gpr[VKMT_RAX] & ~0xffffull) | ctx->fsw;
+            break;
+        }
+        goto x87_giveup;
+    case 0xd8: case 0xda: case 0xdc: case 0xdd: case 0xde:
+    x87_giveup:
+        giveup_dump( ctx, op, "x87 FPU opcode hit (mingw CRT should use SSE2 — investigate)" );
+        return FALSE;
+    case 0xe0: case 0xe1: case 0xe2:  /* loopne/loope/loop */
+    {
+        ULONGLONG target = (ULONG_PTR)(insn->start + insn->len + (signed char)insn->imm);
+        BOOL take;
+        ctx->gpr[VKMT_RCX]--;
+        if (op == 0xe2) take = ctx->gpr[VKMT_RCX] != 0;
+        else if (op == 0xe1) take = ctx->gpr[VKMT_RCX] && (ctx->eflags & FL_ZF);
+        else take = ctx->gpr[VKMT_RCX] && !(ctx->eflags & FL_ZF);
+        if (take) branch_to( ctx, target );
+        else ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+        return TRUE;
+    }
+    case 0xe3:  /* jrcxz */
+        if (!ctx->gpr[VKMT_RCX])
+            branch_to( ctx, (ULONG_PTR)(insn->start + insn->len + (signed char)insn->imm) );
+        else
+            ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+        return TRUE;
+    case 0xe8:  /* call rel32 */
+        push( ctx, (ULONG_PTR)(insn->start + insn->len) );
+        branch_to( ctx, (ULONG_PTR)(insn->start + insn->len + (INT)insn->imm) );
+        return TRUE;
+    case 0xe9:  /* jmp rel32 */
+        branch_to( ctx, (ULONG_PTR)(insn->start + insn->len + (INT)insn->imm) );
+        return TRUE;
+    case 0xeb:  /* jmp rel8 */
+        branch_to( ctx, (ULONG_PTR)(insn->start + insn->len + (signed char)insn->imm) );
+        return TRUE;
+    case 0xf5:  /* cmc */
+        ctx->eflags ^= FL_CF;
+        break;
+    case 0xf6: case 0xf7:  /* group3 */
+    {
+        UINT size = (op == 0xf6) ? 1 : opsize;
+        ULONGLONG a;
+        switch (insn->reg & 7)
+        {
+        case 0: case 1:  /* test imm */
+        {
+            ULONGLONG b = insn->imm;
+            if (size == 2) b = (SHORT)b;
+            else if (size > 1 && insn->imm_size < size) b = (ULONGLONG)(LONGLONG)(INT)b;
+            alu_op( ctx, 4, get_rm( ctx, insn, size ), b, size, FALSE );
+            break;
+        }
+        case 2:  /* not */
+            set_rm( ctx, insn, size, ~get_rm( ctx, insn, size ) );
+            break;
+        case 3:  /* neg */
+            set_rm( ctx, insn, size, alu_op( ctx, 5, 0, get_rm( ctx, insn, size ), size, FALSE ) );
+            break;
+        case 4:  /* mul */
+        case 5:  /* imul */
+        {
+            ULONGLONG b;
+            a = get_rm( ctx, insn, size );
+            b = get_reg( ctx, VKMT_RAX, size, TRUE );
+            if (size == 8)
+            {
+                unsigned __int128 full;
+                if ((insn->reg & 7) == 4) full = (unsigned __int128)a * b;
+                else full = (unsigned __int128)(__int128)(LONGLONG)a * (__int128)(LONGLONG)b;
+                ctx->gpr[VKMT_RAX] = (ULONGLONG)full;
+                ctx->gpr[VKMT_RDX] = (ULONGLONG)(full >> 64);
+                ctx->eflags &= ~(FL_CF | FL_OF);
+                if ((insn->reg & 7) == 4 ? (full >> 64) != 0
+                                        : full >> 64 != ((ULONGLONG)full & sz_sign(8) ? ~0ull : 0))
+                    ctx->eflags |= FL_CF | FL_OF;
+            }
+            else if (size == 4)
+            {
+                ULONGLONG full;
+                if ((insn->reg & 7) == 4) full = (ULONGLONG)(UINT)a * (UINT)b;
+                else full = (ULONGLONG)(LONGLONG)(INT)a * (INT)b;
+                ctx->gpr[VKMT_RAX] = (UINT)full;
+                ctx->gpr[VKMT_RDX] = (UINT)(full >> 32);
+                ctx->eflags &= ~(FL_CF | FL_OF);
+                if ((insn->reg & 7) == 4 ? (full >> 32) != 0
+                                        : (UINT)(full >> 32) != (((UINT)full & 0x80000000) ? 0xffffffff : 0))
+                    ctx->eflags |= FL_CF | FL_OF;
+            }
+            else if (size == 2)
+            {
+                UINT full;
+                if ((insn->reg & 7) == 4) full = (UINT)(USHORT)a * (USHORT)b;
+                else full = (UINT)(INT)(SHORT)a * (SHORT)b;
+                ctx->gpr[VKMT_RAX] = (ctx->gpr[VKMT_RAX] & ~0xffffull) | (full & 0xffff);
+                ctx->gpr[VKMT_RDX] = (ctx->gpr[VKMT_RDX] & ~0xffffull) | ((full >> 16) & 0xffff);
+                ctx->eflags &= ~(FL_CF | FL_OF);
+                if ((insn->reg & 7) == 4 ? (full >> 16) != 0
+                                        : (USHORT)(full >> 16) != ((full & 0x8000) ? 0xffff : 0))
+                    ctx->eflags |= FL_CF | FL_OF;
+            }
+            else
+            {
+                UINT full;
+                if ((insn->reg & 7) == 4) full = (UINT)(BYTE)a * (BYTE)b;
+                else full = (UINT)(INT)(signed char)a * (signed char)b;
+                ctx->gpr[VKMT_RAX] = (ctx->gpr[VKMT_RAX] & ~0xffffull) | (full & 0xffff);
+                ctx->eflags &= ~(FL_CF | FL_OF);
+                if ((insn->reg & 7) == 4 ? (full >> 8) != 0
+                                        : (BYTE)(full >> 8) != ((full & 0x80) ? 0xff : 0))
+                    ctx->eflags |= FL_CF | FL_OF;
+            }
+            break;
+        }
+        case 6:  /* div */
+        case 7:  /* idiv */
+        {
+            a = get_rm( ctx, insn, size );
+            if (!a)
+            {
+                giveup_dump( ctx, op, "integer divide by zero (#DE)" );
+                return FALSE;
+            }
+            if (size == 8)
+            {
+                if ((insn->reg & 7) == 6)
+                {
+                    unsigned __int128 dividend = ((unsigned __int128)ctx->gpr[VKMT_RDX] << 64) | ctx->gpr[VKMT_RAX];
+                    ctx->gpr[VKMT_RAX] = (ULONGLONG)(dividend / a);
+                    ctx->gpr[VKMT_RDX] = (ULONGLONG)(dividend % a);
+                }
+                else
+                {
+                    __int128 dividend = (__int128)(((unsigned __int128)ctx->gpr[VKMT_RDX] << 64) | ctx->gpr[VKMT_RAX]);
+                    ctx->gpr[VKMT_RAX] = (ULONGLONG)(dividend / (LONGLONG)a);
+                    ctx->gpr[VKMT_RDX] = (ULONGLONG)(dividend % (LONGLONG)a);
+                }
+            }
+            else if (size == 4)
+            {
+                ULONGLONG dividend = ((ULONGLONG)(UINT)ctx->gpr[VKMT_RDX] << 32) | (UINT)ctx->gpr[VKMT_RAX];
+                if ((insn->reg & 7) == 6)
+                {
+                    ctx->gpr[VKMT_RAX] = (UINT)(dividend / (UINT)a);
+                    ctx->gpr[VKMT_RDX] = (UINT)(dividend % (UINT)a);
+                }
+                else
+                {
+                    LONGLONG sd = (LONGLONG)dividend;
+                    ctx->gpr[VKMT_RAX] = (UINT)(sd / (INT)a);
+                    ctx->gpr[VKMT_RDX] = (UINT)(sd % (INT)a);
+                }
+            }
+            else if (size == 2)
+            {
+                UINT dividend = ((UINT)(USHORT)ctx->gpr[VKMT_RDX] << 16) | (USHORT)ctx->gpr[VKMT_RAX];
+                UINT q, r;
+                if ((insn->reg & 7) == 6) { q = dividend / (USHORT)a; r = dividend % (USHORT)a; }
+                else { INT sd = (INT)dividend; q = (UINT)(sd / (SHORT)a); r = (UINT)(sd % (SHORT)a); }
+                ctx->gpr[VKMT_RAX] = (ctx->gpr[VKMT_RAX] & ~0xffffull) | (q & 0xffff);
+                ctx->gpr[VKMT_RDX] = (ctx->gpr[VKMT_RDX] & ~0xffffull) | (r & 0xffff);
+            }
+            else
+            {
+                UINT dividend = (USHORT)ctx->gpr[VKMT_RAX];
+                UINT q, r;
+                if ((insn->reg & 7) == 6) { q = dividend / (BYTE)a; r = dividend % (BYTE)a; }
+                else { SHORT sd = (SHORT)dividend; q = (UINT)(sd / (signed char)a); r = (UINT)(sd % (signed char)a); }
+                ctx->gpr[VKMT_RAX] = (ctx->gpr[VKMT_RAX] & ~0xffffull) | ((q & 0xff) | ((r & 0xff) << 8));
+            }
+            break;
+        }
+        }
+        break;
+    }
+    case 0xf8: ctx->eflags &= ~FL_CF; break;  /* clc */
+    case 0xf9: ctx->eflags |= FL_CF; break;   /* stc */
+    case 0xfa: case 0xfb: break;              /* cli/sti: no-op in emulator */
+    case 0xfc: ctx->eflags &= ~FL_DF; break;  /* cld */
+    case 0xfd: ctx->eflags |= FL_DF; break;   /* std */
+    case 0xfe:  /* inc/dec r/m8 */
+        if ((insn->reg & 7) == 0)
+            set_rm( ctx, insn, 1, alu_op( ctx, 0, get_rm( ctx, insn, 1 ), 1, 1, TRUE ) );
+        else if ((insn->reg & 7) == 1)
+            set_rm( ctx, insn, 1, alu_op( ctx, 5, get_rm( ctx, insn, 1 ), 1, 1, TRUE ) );
+        else { giveup_dump( ctx, op, "bad group4" ); return FALSE; }
+        break;
+    case 0xff:  /* group5 */
+        switch (insn->reg & 7)
+        {
+        case 0:
+            if (insn->pref & P_LOCK && !insn->rm_is_reg)
+            {
+                if (opsize == 8) __atomic_fetch_add( (ULONGLONG *)(ULONG_PTR)insn->ea, 1, __ATOMIC_SEQ_CST );
+                else if (opsize == 4) __atomic_fetch_add( (UINT *)(ULONG_PTR)insn->ea, 1, __ATOMIC_SEQ_CST );
+                else __atomic_fetch_add( (USHORT *)(ULONG_PTR)insn->ea, 1, __ATOMIC_SEQ_CST );
+                /* flags from locked inc are not needed for correctness of the RMW;
+                 * compute them on the pre-increment value */
+                alu_op( ctx, 0, get_rm( ctx, insn, opsize ) - 1, 1, opsize, TRUE );
+            }
+            else set_rm( ctx, insn, opsize, alu_op( ctx, 0, get_rm( ctx, insn, opsize ), 1, opsize, TRUE ) );
+            break;
+        case 1:
+            if (insn->pref & P_LOCK && !insn->rm_is_reg)
+            {
+                if (opsize == 8) __atomic_fetch_sub( (ULONGLONG *)(ULONG_PTR)insn->ea, 1, __ATOMIC_SEQ_CST );
+                else if (opsize == 4) __atomic_fetch_sub( (UINT *)(ULONG_PTR)insn->ea, 1, __ATOMIC_SEQ_CST );
+                else __atomic_fetch_sub( (USHORT *)(ULONG_PTR)insn->ea, 1, __ATOMIC_SEQ_CST );
+                alu_op( ctx, 5, get_rm( ctx, insn, opsize ) + 1, 1, opsize, TRUE );
+            }
+            else set_rm( ctx, insn, opsize, alu_op( ctx, 5, get_rm( ctx, insn, opsize ), 1, opsize, TRUE ) );
+            break;
+        case 2:  /* call r/m64 */
+            push( ctx, (ULONG_PTR)(insn->start + insn->len) );
+            branch_to( ctx, get_rm( ctx, insn, 8 ) );
+            return TRUE;
+        case 4:  /* jmp r/m64 */
+            branch_to( ctx, get_rm( ctx, insn, 8 ) );
+            return TRUE;
+        case 6:  /* push r/m64 */
+            push( ctx, get_rm( ctx, insn, 8 ) );
+            break;
+        default:
+            giveup_dump( ctx, op, "unsupported group5 (far call/jmp)" );
+            return FALSE;
+        }
+        break;
+    default:
+        return FALSE;  /* handled by 0F map or giveup in caller */
+    }
+
+    ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+    return TRUE;
+}
+
+/* extended (0F) map, incl. SSE/SSE2 */
+static BOOL exec_0f( struct vkmt_x64_context *ctx, const struct vkmt_insn *insn )
+{
+    UINT op = insn->opcode & 0xff;
+    UINT opsize = (insn->rex & 8) ? 8 : ((insn->pref & P_66) ? 2 : 4);
+
+    if (op >= 0x40 && op <= 0x4f)  /* cmovcc */
+    {
+        if (cc_result( ctx, op & 0xf ))
+            set_reg( ctx, insn->reg, opsize, insn->rex != 0, get_rm( ctx, insn, opsize ) );
+        ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+        return TRUE;
+    }
+    if (op >= 0x80 && op <= 0x8f)  /* jcc rel32 */
+    {
+        if (cc_result( ctx, op & 0xf ))
+            branch_to( ctx, (ULONG_PTR)(insn->start + insn->len + (INT)insn->imm) );
+        else
+            ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+        return TRUE;
+    }
+    if (op >= 0x90 && op <= 0x9f)  /* setcc */
+    {
+        set_rm( ctx, insn, 1, cc_result( ctx, op & 0xf ) ? 1 : 0 );
+        ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+        return TRUE;
+    }
+    if (op >= 0xc8 && op <= 0xcf)  /* bswap */
+    {
+        UINT idx = (op & 7) | ((insn->rex & 1) << 3);
+        ULONGLONG v = ctx->gpr[idx];
+        if (insn->rex & 8)
+            ctx->gpr[idx] = ((v & 0xffull) << 56) | ((v & 0xff00ull) << 40) |
+                            ((v & 0xff0000ull) << 24) | ((v & 0xff000000ull) << 8) |
+                            ((v >> 8) & 0xff000000ull) | ((v >> 24) & 0xff0000ull) |
+                            ((v >> 40) & 0xff00ull) | ((v >> 56) & 0xffull);
+        else
+            ctx->gpr[idx] = ((v & 0xff) << 24) | ((v & 0xff00) << 8) |
+                            ((v >> 8) & 0xff00) | ((v >> 24) & 0xff);
+        ctx->rip = (ULONG_PTR)(insn->start + insn->len);
+        return TRUE;
+    }
+
+    switch (op)
+    {
+    case 0x01:
+        if (insn->has_modrm && insn->rm_is_reg && insn->reg == 7 && insn->rm == 1)  /* rdtscp (0f 01 f9) */
+        {
+            ULONGLONG t = read_tsc();
