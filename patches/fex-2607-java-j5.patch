+void InvalidationTracker::InvalidateWritableExecutableCode() {
+  std::vector<std::pair<uint64_t, uint64_t>> Ranges;
+  {
+    std::shared_lock Lock(IntervalsLock);
+    for (const auto& Interval : RWXIntervals) {
+      Ranges.emplace_back(Interval.Offset, Interval.End - Interval.Offset);
+    }
+  }
+
+  /*
+   * A native x86 runtime can patch inline caches or embedded GC roots without
+   * an explicit instruction-cache flush.  Synchronization waits publish those
+   * writes to other threads.  A clean tracked page is trapped RX; a page made
+   * writable by a patch is RWX.  Invalidate and reprotect only those dirty
+   * pages, so ordinary waits and immutable PE text remain cached.
+   */
+  for (const auto& [Address, Size] : Ranges) {
+    MEMORY_BASIC_INFORMATION Info;
+    if (NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Address),
+                             MemoryBasicInformation, &Info, sizeof(Info), nullptr) ||
+        !ProtIsWritable(Info.Protect)) {
+      continue;
+    }
+    InvalidateIntervalInternal(Address, Size);
+    ReprotectRWXIntervals(Address, Size);
+  }
