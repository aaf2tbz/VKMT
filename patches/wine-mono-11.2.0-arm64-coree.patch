--- a/mono/mono/metadata/coree.c
+++ b/mono/mono/metadata/coree.c
@@ -68,7 +68,8 @@
 HMODULE coree_module_handle = NULL;
 static gboolean init_from_coree = FALSE;
 
-#if defined(HAVE_API_SUPPORT_WIN32_COREE) && (!defined(_WIN64) || defined(_M_IA64) || defined(_M_AMD64))
+/* VKMT: Wine's native ARM64 mscoree needs the same CoreEE contract as x64. */
+#if defined(HAVE_API_SUPPORT_WIN32_COREE) && (!defined(_WIN64) || defined(_M_IA64) || defined(_M_AMD64) || defined(_M_ARM64) || defined(__aarch64__))
 #include <shellapi.h>
 
 /* Entry point called by LdrLoadDll of ntdll.dll after _CorValidateImage. */
@@ -552,6 +553,12 @@
 #define ELEMENT_SIZE sizeof(PLABEL_DESCRIPTOR)
 #define REGION_WRITE_PROTECT PAGE_READWRITE
 #define REGION_PROTECT PAGE_READ
+#elif defined(_M_ARM64) || defined(__aarch64__)
+	BYTE* Trampoline;
+
+#define ELEMENT_SIZE 16
+#define REGION_WRITE_PROTECT PAGE_EXECUTE_READWRITE
+#define REGION_PROTECT PAGE_EXECUTE_READ
 #else
 	BYTE* Trampoline;
 
@@ -647,6 +654,15 @@
 			*(Trampoline)++ = 0x41;
 			*(Trampoline)++ = 0xFF;
 			*(Trampoline)++ = 0xE3;
+#elif defined(_M_ARM64) || defined(__aarch64__)
+			ProcRva = (DWORD)((DWORD_PTR)Trampoline - (DWORD_PTR)DosHeader);
+			/* ldr x16, #8; br x16; .quad ExportFixup->ProcAddress */
+			*(DWORD*)Trampoline = 0x58000050;
+			Trampoline += sizeof (DWORD);
+			*(DWORD*)Trampoline = 0xd61f0200;
+			Trampoline += sizeof (DWORD);
+			memcpy (Trampoline, ExportFixup->ProcAddress.Bytes, sizeof (PVOID));
+			Trampoline += sizeof (PVOID);
 #else
 #error Unsupported architecture.
 #endif
--- a/mono/mono/mini/interp/interp.c
+++ b/mono/mono/mini/interp/interp.c
@@ -1564,6 +1564,22 @@
 		mono_error_assert_ok (error);
 #else
 		entry_func = get_interp_to_native_trampoline ();
+#endif
+#if defined(HOST_WIN32) && (defined(_M_ARM64) || defined(__aarch64__))
+		/*
+		 * VKMT: Darwin ARM64 enforces W^X, so Wine deliberately maps an
+		 * initial PAGE_EXECUTE_READWRITE request as writable.  Both ARM64
+		 * interpreter implementations produce this native P/Invoke bridge;
+		 * make its completed page executable before the first call.
+		 */
+		{
+			const gsize host_page_size = 0x4000;
+			gpointer host_page = (gpointer)((gsize)entry_func & ~(host_page_size - 1));
+			DWORD old_protect;
+			FlushInstructionCache (GetCurrentProcess (), host_page, host_page_size);
+			if (!VirtualProtect (host_page, host_page_size, PAGE_EXECUTE_READ, &old_protect))
+				g_error ("Failed to make interpreter P/Invoke trampoline executable");
+		}
 #endif
 		mono_memory_barrier ();
 		MONO_EXIT_GC_UNSAFE;
