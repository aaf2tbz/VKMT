diff --git a/dlls/wow64/virtual.c b/dlls/wow64/virtual.c
index dd744bd..b698662 100644
--- a/dlls/wow64/virtual.c
+++ b/dlls/wow64/virtual.c
@@ -928,7 +928,11 @@ NTSTATUS WINAPI wow64_NtUnmapViewOfSection( UINT *args )
 
     if (is_current && pBTCpuNotifyUnmapViewOfSection) pBTCpuNotifyUnmapViewOfSection( addr, FALSE, 0 );
     status = NtUnmapViewOfSection( process, addr );
-    if (NT_SUCCESS(status) && registered && !wow64_unregister_guest_memory_by_host( guest, addr, size ))
+    /* A section view can have been split by commit/decommit bookkeeping.
+     * UnmapViewOfSection retires the complete reservation even when the
+     * caller supplies an address inside that view; pass size=0 so the
+     * registry removes every interval sharing the reservation identity. */
+    if (NT_SUCCESS(status) && registered && !wow64_unregister_guest_memory_by_host( guest, addr, 0 ))
     {
         ERR( "i386 unmap registry retirement failed host %p guest %08lx size %Iu\n", addr, guest, size );
         status = STATUS_INTERNAL_ERROR;
@@ -955,7 +959,7 @@ NTSTATUS WINAPI wow64_NtUnmapViewOfSectionEx( UINT *args )
 
     if (is_current && pBTCpuNotifyUnmapViewOfSection) pBTCpuNotifyUnmapViewOfSection( addr, FALSE, 0 );
     status = NtUnmapViewOfSectionEx( process, addr, flags );
-    if (NT_SUCCESS(status) && registered && !wow64_unregister_guest_memory_by_host( guest, addr, size ))
+    if (NT_SUCCESS(status) && registered && !wow64_unregister_guest_memory_by_host( guest, addr, 0 ))
         status = STATUS_INTERNAL_ERROR;
     if (is_current && pBTCpuNotifyUnmapViewOfSection) pBTCpuNotifyUnmapViewOfSection( addr, TRUE, status );
     return status;
