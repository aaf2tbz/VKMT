diff --git a/meson.build b/meson.build
index 032e75e..efd9994 100644
--- a/meson.build
+++ b/meson.build
@@ -227,3 +227,16 @@ if platform != 'windows'
 endif
 
 subdir('src')
+
+# VKMT: rewrite [x18] TLS operands to [x28] in freshly linked PE binaries.
+if platform == 'windows' and cpu_family == 'aarch64'
+  vkmt_tls_dlls = [dxgi_dll]
+  if get_option('enable_d3d11')
+    vkmt_tls_dlls += [d3d11_dll]
+  endif
+  custom_target('fix-x18-tls',
+    input   : vkmt_tls_dlls,
+    output  : 'fix-x18-tls.stamp',
+    command : ['sh', '-c', 'python3 /Volumes/AverySSD/VKMT/scripts/fix-x18-tls.py "$@" && touch "$0"', '@OUTPUT@', '@INPUT@'],
+    build_by_default : true)
+endif
