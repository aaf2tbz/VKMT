+#pragma mark -
+#pragma mark MVKCmdBeginTransformFeedback
+
+// Metal has no native transform feedback. Stream output is currently emulated as
+// passthrough: buffers and counter buffers are tracked, but draws execute normally
+// without capturing vertex output. Logged once so apps know capture is not happening.
+static bool _mvkXfbPassthroughLogged = false;
+
+VkResult MVKCmdBeginTransformFeedback::setContent(MVKCommandBuffer* cmdBuff,
+												  uint32_t firstCounterBuffer,
+												  uint32_t counterBufferCount,
+												  const VkBuffer* pCounterBuffers,
+												  const VkDeviceSize* pCounterBufferOffsets) {
+	_firstCounterBuffer = firstCounterBuffer;
+	_counterBuffers.clear();	// Clear for reuse
+	_counterBuffers.reserve(counterBufferCount);
+	MVKVertexMTLBufferBinding b;
+	b.stride = 0;
+	for (uint32_t cbIdx = 0; cbIdx < counterBufferCount; cbIdx++) {
+		MVKBuffer* mvkBuffer = pCounterBuffers ? (MVKBuffer*)pCounterBuffers[cbIdx] : nullptr;
+		if (mvkBuffer) {
+			b.mtlBuffer = mvkBuffer->getMTLBuffer();
+			b.offset = mvkBuffer->getMTLBufferOffset() + (pCounterBufferOffsets ? pCounterBufferOffsets[cbIdx] : 0);
+			b.size = 4;
+		} else {
+			b.mtlBuffer = nullptr;
+			b.offset = 0;
+			b.size = 0;
+		}
+		_counterBuffers.push_back(b);
+	}
+
+	return VK_SUCCESS;
+}
+
+void MVKCmdBeginTransformFeedback::encode(MVKCommandEncoder* cmdEncoder) {
+	if ( !_mvkXfbPassthroughLogged ) {
+		_mvkXfbPassthroughLogged = true;
+		MVKLogWarn("VK_EXT_transform_feedback is emulated as passthrough. Stream output buffers are tracked, but vertex output is not captured.");
+	}
+	cmdEncoder->getState().beginTransformFeedback(_firstCounterBuffer, _counterBuffers.contents());
+}
+
+
+#pragma mark -
+#pragma mark MVKCmdEndTransformFeedback
+
+VkResult MVKCmdEndTransformFeedback::setContent(MVKCommandBuffer* cmdBuff,
+												uint32_t firstCounterBuffer,
+												uint32_t counterBufferCount,
+												const VkBuffer* pCounterBuffers,
+												const VkDeviceSize* pCounterBufferOffsets) {
+	_firstCounterBuffer = firstCounterBuffer;
+	_counterBuffers.clear();	// Clear for reuse
+	_counterBuffers.reserve(counterBufferCount);
+	MVKVertexMTLBufferBinding b;
+	b.stride = 0;
+	for (uint32_t cbIdx = 0; cbIdx < counterBufferCount; cbIdx++) {
+		MVKBuffer* mvkBuffer = pCounterBuffers ? (MVKBuffer*)pCounterBuffers[cbIdx] : nullptr;
+		if (mvkBuffer) {
+			b.mtlBuffer = mvkBuffer->getMTLBuffer();
+			b.offset = mvkBuffer->getMTLBufferOffset() + (pCounterBufferOffsets ? pCounterBufferOffsets[cbIdx] : 0);
+			b.size = 4;
+		} else {
+			b.mtlBuffer = nullptr;
+			b.offset = 0;
+			b.size = 0;
+		}
+		_counterBuffers.push_back(b);
+	}
+
+	return VK_SUCCESS;
+}
+
+void MVKCmdEndTransformFeedback::encode(MVKCommandEncoder* cmdEncoder) {
+	cmdEncoder->getState().endTransformFeedback();
+}
+
+
+#pragma mark -
+#pragma mark MVKCmdDrawIndirectByteCount
+
+VkResult MVKCmdDrawIndirectByteCount::setContent(MVKCommandBuffer* cmdBuff,
+												 uint32_t instanceCount,
+												 uint32_t firstInstance,
+												 VkBuffer counterBuffer,
+												 VkDeviceSize counterBufferOffset,
+												 uint32_t counterOffset,
+												 uint32_t vertexStride) {
+	_instanceCount = instanceCount;
+	_firstInstance = firstInstance;
+	_counterOffset = counterOffset;
+	_vertexStride = vertexStride;
+
+	MVKBuffer* mvkBuffer = (MVKBuffer*)counterBuffer;
+	_mtlCounterBuffer = mvkBuffer->getMTLBuffer();
+	_mtlCounterBufferOffset = mvkBuffer->getMTLBufferOffset() + counterBufferOffset;
+
+	return VK_SUCCESS;
+}
+
+void MVKCmdDrawIndirectByteCount::encode(MVKCommandEncoder* cmdEncoder) {
+	// The draw count depends on the stream output counter, which is not tracked
+	// in the current passthrough emulation, so this draw cannot be performed.
+	static bool _mvkDrawIndirectByteCountLogged = false;
+	if ( !_mvkDrawIndirectByteCountLogged ) {
+		_mvkDrawIndirectByteCountLogged = true;
+		MVKLogWarn("vkCmdDrawIndirectByteCountEXT is not supported while stream output is emulated as passthrough. Draw skipped.");
+	}
+}
