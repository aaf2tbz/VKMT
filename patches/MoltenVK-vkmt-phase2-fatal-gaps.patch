+void MVKCommandEncoderState::bindTransformFeedbackBuffers(uint32_t firstBinding, MVKArrayRef<const MVKVertexMTLBufferBinding> buffers) {
+	uint32_t end = std::min(firstBinding + (uint32_t)buffers.size(), kMVKMaxTransformFeedbackBufferCount);
+	for (uint32_t i = firstBinding; i < end; i++)
+		_vkGraphics._xfbBuffers[i] = buffers[i - firstBinding];
