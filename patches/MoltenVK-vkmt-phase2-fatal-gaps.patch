+	pXFBProps->transformFeedbackQueries = true;
+	pXFBProps->transformFeedbackStreamsLinesTriangles = false;
+	pXFBProps->transformFeedbackRasterizationStreamSelect = false;
+	pXFBProps->transformFeedbackDraw = true;
