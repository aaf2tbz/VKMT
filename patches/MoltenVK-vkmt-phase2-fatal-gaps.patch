+/** The size of the zeroed buffer bound in place of null buffer descriptors. */
+static constexpr NSUInteger kMVKNullDescriptorMTLBufferSize = 256;
+
+id<MTLBuffer> MVKDevice::getNullDescriptorMTLBuffer() {
+	if ( !_nullDescriptorMTLBuffer ) {
+
+		// Lock and check again in case another thread has created the buffer.
+		lock_guard<mutex> lock(_rezLock);
+		if ( !_nullDescriptorMTLBuffer ) {
+			@autoreleasepool {
+				_nullDescriptorMTLBuffer = [_physicalDevice->_mtlDevice newBufferWithLength: kMVKNullDescriptorMTLBufferSize options: MTLResourceStorageModeShared];	// retained
+				memset(_nullDescriptorMTLBuffer.contents, 0, kMVKNullDescriptorMTLBufferSize);
+			}
+		}
+	}
+	return _nullDescriptorMTLBuffer;
+}
